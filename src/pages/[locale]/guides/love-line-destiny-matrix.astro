---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { supportedLocales } from '../../../config/locales.config';

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const { locale = 'en' } = Astro.params;

const pageTitle = "The Love Line in Destiny Matrix: Complete Guide";
const pageDesc = "Learn what the Love Line in your Destiny Matrix chart reveals about relationship dynamics, attraction, and emotional patterns.";
---

<BaseLayout title={pageTitle} description={pageDesc} locale={locale}>
  <section class="bg-[#F7F3EC] py-16 px-4 font-sans">
    <div class="max-w-4xl mx-auto bg-white rounded-3xl p-8 border border-stone-200/80 shadow-sm space-y-6">
      <span class="text-xs font-bold text-[#B67B7B] uppercase tracking-widest bg-[#F7F3EC] px-3.5 py-1 rounded-full inline-block">
        Destiny Matrix Guide
      </span>
      <h1 class="text-3xl sm:text-4xl font-serif text-[#2E3D34] font-bold">
        Understanding the Love Line in Your Destiny Matrix
      </h1>
      <p class="text-stone-600 leading-relaxed text-sm sm:text-base">
        The Love Line is the diagonal run of numbers in your Destiny Matrix chart that maps your romantic and relationship energy — how you give and receive love, what kind of partner you're naturally drawn to, and the emotional patterns that tend to resurface in relationships until they're consciously addressed.
      </p>
      <div class="pt-4 border-t border-stone-100 flex items-center justify-between text-xs text-stone-500">
        <a href={`/${locale}/`} class="text-[#2E3D34] font-bold hover:underline">
          ← Back to Destiny Matrix Calculator
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
