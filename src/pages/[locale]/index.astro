  <script is:inline>
    function reduce22Val(val) {
      let num = Math.abs(val);
      while (num > 22) {
        num = num.toString().split('').reduce((a, b) => a + parseInt(b, 10), 0);
      }
      return num || 1;
    }

    function parseDobLocal(dStr) {
      if (!dStr) return { d: 14, m: 1, y: 1980 };
      const parts = dStr.split(/[-/.]/);
      if (parts.length !== 3) return { d: 14, m: 1, y: 1980 };
      const p0 = parseInt(parts[0], 10);
      const p1 = parseInt(parts[1], 10);
      const p2 = parseInt(parts[2], 10);
      if (isNaN(p0) || isNaN(p1) || isNaN(p2)) return { d: 14, m: 1, y: 1980 };
      let d = 14, m = 1, y = 1980;
      if (p0 > 31) {
        y = p0; m = p1; d = p2;
      } else if (p2 > 31) {
        d = p0; m = p1; y = p2;
      } else {
        d = p0; m = p1; y = p2 < 100 ? (p2 > 30 ? 1900 + p2 : 2000 + p2) : p2;
      }
      d = Math.max(1, Math.min(31, d));
      m = Math.max(1, Math.min(12, m));
      if (y < 100) y = 2000 + y;
      return { d, m, y };
    }

    function recalculateMatrix(dobVal, nameVal) {
      const { d, m, y } = parseDobLocal(dobVal);

      const dayA = reduce22Val(d);
      const monthB = reduce22Val(m);
      const ySum = y.toString().split('').reduce((a, b) => a + parseInt(b, 10), 0);
      const yearC = reduce22Val(ySum);

      const bottomD = reduce22Val(dayA + monthB + yearC);
      const centerE = reduce22Val(dayA + monthB + yearC + bottomD);

      const moneyVal = reduce22Val(centerE + yearC);
      const loveVal = reduce22Val(centerE + bottomD);

      const topLeft = reduce22Val(dayA + monthB);
      const topRight = reduce22Val(monthB + yearC);
      const bottomRight = reduce22Val(yearC + bottomD);
      const bottomLeft = reduce22Val(bottomD + dayA);

      const lifePath = reduce22Val(dayA + monthB + yearC);
      const soul = monthB;
      const personality = reduce22Val(dayA + centerE);

      const cleanName = (nameVal || 'Kashif').toLowerCase().replace(/[^a-z]/g, '') || 'kashif';
      const letterMap = { a:1,b:2,c:3,d:4,e:5,f:6,g:7,h:8,i:9,j:1,k:2,l:3,m:4,n:5,o:6,p:7,q:8,r:9,s:1,t:2,u:3,v:4,w:5,x:6,y:7,z:8 };
      let nSum = 0;
      for (let i = 0; i < cleanName.length; i++) nSum += letterMap[cleanName[i]] || 0;
      const expression = reduce22Val(nSum);

      document.getElementById('svgCenterArcana').textContent = centerE;
      document.getElementById('svgDayArcana').textContent = dayA;
      document.getElementById('svgMonthArcana').textContent = monthB;
      document.getElementById('svgYearArcana').textContent = yearC;
      document.getElementById('svgBottomArcana').textContent = bottomD;
      document.getElementById('svgMoneyArcana').textContent = moneyVal;
      document.getElementById('svgLoveArcana').textContent = loveVal;
      document.getElementById('svgTopLeftArcana').textContent = topLeft;
      document.getElementById('svgTopRightArcana').textContent = topRight;
      document.getElementById('svgBottomRightArcana').textContent = bottomRight;
      document.getElementById('svgBottomLeftArcana').textContent = bottomLeft;

      document.getElementById('resSoulNum').textContent = soul;
      document.getElementById('resPersonalityNum').textContent = personality;
      document.getElementById('resExpressionNum').textContent = expression;
      document.getElementById('resLifePathNum').textContent = lifePath;

      // Update Report Links dynamically
      const currentLocale = window.location.pathname.startsWith('/ar') ? 'ar' : (window.location.pathname.startsWith('/pt') ? 'pt' : 'en');
      const fullLink = document.getElementById('openFullReportLink');
      if (fullLink) fullLink.href = `/${currentLocale}/report?dob=${dobVal}&name=${encodeURIComponent(nameVal)}`;
    }

    function initMatrixEvents() {
      const form = document.getElementById('matrixForm');
      const spinner = document.getElementById('btnSpinner');
      const btnText = document.getElementById('btnText');
      const nameInp = document.getElementById('matrixNameInput');
      const dobInp = document.getElementById('matrixDobInput');
      const targetSec = document.getElementById('matrixResultSection');
      const openFullReportLink = document.getElementById('openFullReportLink');

      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const nameVal = nameInp ? nameInp.value.trim() : '';
          const dobVal = dobInp ? dobInp.value : '';
          const currentLocale = window.location.pathname.startsWith('/ar') ? 'ar' : (window.location.pathname.startsWith('/pt') ? 'pt' : 'en');

          if (!nameVal || !dobVal) {
            if (nameInp && !nameVal) nameInp.focus();
            else if (dobInp && !dobVal) dobInp.focus();
            alert(currentLocale === 'ar' ? 'يرجى إدخال الاسم وتاريخ الميلاد أولاً.' : (currentLocale === 'pt' ? 'Por favor, insira o nome e a data de nascimento primeiro.' : 'Please enter your name and date of birth first.'));
            return;
          }

          const parts = dobVal.split('-');
          const year = parts[0] ? parseInt(parts[0], 10) : 0;
          const currentYear = new Date().getFullYear();
          if (isNaN(year) || year < 1900 || year > currentYear) {
            if (dobInp) dobInp.focus();
            alert(currentLocale === 'ar' 
              ? `يرجى إدخال سنة ميلاد صالحة بين 1900 و ${currentYear}.` 
              : (currentLocale === 'pt' ? `Por favor, insira um ano de nascimento válido entre 1900 e ${currentYear}.` : `Please enter a valid birth year between 1900 and ${currentYear}.`));
            return;
          }

          if (openFullReportLink) {
            openFullReportLink.href = `/${currentLocale}/report?dob=${encodeURIComponent(dobVal)}&name=${encodeURIComponent(nameVal)}`;
          }

          // Quick Questions Href Bindings
          const qqTheme = document.getElementById('qqThemeBtn');
          const qqCareer = document.getElementById('qqCareerBtn');
          const qqLove = document.getElementById('qqLoveBtn');
          const qqKarmic = document.getElementById('qqKarmicBtn');
          if (qqTheme) qqTheme.href = `/${currentLocale}/report?dob=${encodeURIComponent(dobVal)}&name=${encodeURIComponent(nameVal)}#core-personality`;
          if (qqCareer) qqCareer.href = `/${currentLocale}/report?dob=${encodeURIComponent(dobVal)}&name=${encodeURIComponent(nameVal)}#career-money`;
          if (qqLove) qqLove.href = `/${currentLocale}/report?dob=${encodeURIComponent(dobVal)}&name=${encodeURIComponent(nameVal)}#love-compatibility`;
          if (qqKarmic) qqKarmic.href = `/${currentLocale}/report?dob=${encodeURIComponent(dobVal)}&name=${encodeURIComponent(nameVal)}#karmic-blueprint`;

          if (spinner) spinner.classList.remove('hidden');
          const originalText = btnText ? btnText.textContent : '';
          if (btnText) btnText.textContent = currentLocale === 'ar' ? 'جاري الحساب...' : (currentLocale === 'pt' ? 'Calculando...' : 'Calculating...');
          setTimeout(() => {
            recalculateMatrix(dobVal, nameVal);
            if (spinner) spinner.classList.add('hidden');
            if (btnText) btnText.textContent = originalText;
            if (targetSec) targetSec.scrollIntoView({ behavior: 'smooth' });
          }, 200);
        });
      }

      // Prevent navigation if name and DOB are not filled
      const reportLinks = [
        openFullReportLink,
        document.getElementById('qqThemeBtn'),
        document.getElementById('qqCareerBtn'),
        document.getElementById('qqLoveBtn'),
        document.getElementById('qqKarmicBtn')
      ];
      reportLinks.forEach(link => {
        if (link) {
          link.addEventListener('click', (e) => {
            const nameRaw = nameInp ? nameInp.value.trim() : '';
            const dobRaw = dobInp ? dobInp.value : '';
            const currentLocale = window.location.pathname.startsWith('/ar') ? 'ar' : (window.location.pathname.startsWith('/pt') ? 'pt' : 'en');
            
            if (!nameRaw || !dobRaw) {
              e.preventDefault();
              if (nameInp && !nameRaw) nameInp.focus();
              else if (dobInp && !dobRaw) dobInp.focus();
              alert(currentLocale === 'ar' ? 'يرجى إدخال الاسم وتاريخ الميلاد أولاً.' : (currentLocale === 'pt' ? 'Por favor, insira o nome e a data de nascimento primeiro.' : 'Please enter your name and date of birth first.'));
              return;
            }

            const parts = dobRaw.split('-');
            const year = parts[0] ? parseInt(parts[0], 10) : 0;
            const currentYear = new Date().getFullYear();
            if (isNaN(year) || year < 1900 || year > currentYear) {
              e.preventDefault();
              if (dobInp) dobInp.focus();
              alert(currentLocale === 'ar' 
                ? `يرجى إدخال سنة ميلاد صالحة بين 1900 و ${currentYear}.` 
                : (currentLocale === 'pt' ? `Por favor, insira um ano de nascimento válido entre 1900 e ${currentYear}.` : `Please enter a valid birth year between 1900 and ${currentYear}.`));
              return;
            }

            // Dynamically build the target url based on the field values
            let targetUrl = `/${currentLocale}/report?dob=${encodeURIComponent(dobRaw)}&name=${encodeURIComponent(nameRaw)}`;
            if (link.id === 'qqThemeBtn') targetUrl += '#core-personality';
            else if (link.id === 'qqCareerBtn') targetUrl += '#career-money';
            else if (link.id === 'qqLoveBtn') targetUrl += '#love-compatibility';
            else if (link.id === 'qqKarmicBtn') targetUrl += '#karmic-blueprint';
            link.href = targetUrl;
          });
        }
      });
    }

    window.addEventListener('load', initMatrixEvents);
    document.addEventListener('DOMContentLoaded', initMatrixEvents);
  </script>
