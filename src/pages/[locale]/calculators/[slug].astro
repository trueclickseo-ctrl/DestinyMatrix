---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Button from '../../../components/ui/Button.astro';
import Card from '../../../components/ui/Card.astro';
import Input from '../../../components/ui/Input.astro';
import FormField from '../../../components/ui/FormField.astro';
import Icon from '../../../components/ui/Icon.astro';
import { numerologyCalculators, type CalculatorConfig } from '../../../config/calculators.config';
import { supportedLocales } from '../../../config/locales.config';
import { t } from '../../../i18n';
import { SchemaEngine } from '../../../engines/schema';

export function getStaticPaths() {
  const paths = [];
  for (const locale of supportedLocales) {
    for (const calc of numerologyCalculators) {
      paths.push({ params: { locale, slug: calc.slug } });
    }
  }
  return paths;
}

const { locale = 'en', slug } = Astro.params;
const currentLocale = locale;

const currentCalc = numerologyCalculators.find((c: CalculatorConfig) => c.slug === slug) || numerologyCalculators[0];

const appSchema = SchemaEngine.generateSoftwareApplicationSchema(
  t(currentCalc.titleKey, currentLocale),
  t(currentCalc.descKey, currentLocale),
  `https://souliography.com/${currentLocale}/calculators/${currentCalc.slug}/`
);
---

<BaseLayout
  title={t(currentCalc.titleKey, currentLocale)}
  description={t(currentCalc.descKey, currentLocale)}
  locale={currentLocale}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(appSchema)} />

  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-violet-950 via-purple-900 to-slate-900 text-white py-16 px-4 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-amber-400/10 via-pink-500/10 to-transparent"></div>
    <div class="max-w-4xl mx-auto text-center space-y-4 relative z-10">
      <div class="inline-flex items-center justify-center p-4 rounded-full bg-amber-400/20 text-amber-300 ring-2 ring-amber-400/40 mb-2 shadow-lg">
        <Icon symbol={currentCalc.icon} size="lg" />
      </div>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight font-heading bg-gradient-to-r from-amber-200 via-pink-200 to-white bg-clip-text text-transparent">
        {t(currentCalc.titleKey, currentLocale)}
      </h1>
      <p class="text-purple-200 max-w-xl mx-auto text-base sm:text-lg font-medium">
        {t(currentCalc.descKey, currentLocale)}
      </p>

      <!-- Trust Badges Bar -->
      <div class="pt-4 flex flex-wrap justify-center items-center gap-3 text-xs font-semibold text-amber-200">
        <span class="bg-white/10 px-3 py-1.5 rounded-full border border-amber-300/30">✓ Free Pythagorean System</span>
        <span class="bg-white/10 px-3 py-1.5 rounded-full border border-amber-300/30">✓ Instant Browser Processing</span>
        <span class="bg-white/10 px-3 py-1.5 rounded-full border border-amber-300/30">✓ Master Numbers (11, 22, 33)</span>
      </div>
    </div>
  </section>

  <!-- Interactive Section Area -->
  <div class="bg-gradient-to-b from-purple-50 via-pink-50/50 to-amber-50/30 py-12 px-4">
    <div class="max-w-4xl mx-auto space-y-12">

      <!-- Form Section in Soft Pearl Rose Card -->
      <Card variant="elevated" class="max-w-md mx-auto border-2 border-purple-200 shadow-2xl -mt-20 relative z-20 bg-white">
        <form id="calculatorForm" class="space-y-6" action="javascript:void(0);">
          <FormField
            label={currentCalc.inputType === 'date' ? t('form.birthDate', currentLocale) : currentCalc.inputType === 'address' ? t('form.address', currentLocale) : currentCalc.inputType === 'phone' ? t('form.phone', currentLocale) : currentCalc.inputType === 'plate' ? t('form.plate', currentLocale) : t('form.fullName', currentLocale)}
            htmlFor="calcInput"
            required
          >
            <Input
              type={currentCalc.inputType === 'date' ? 'date' : 'text'}
              id="calcInput"
              name="calcInput"
              value={currentCalc.inputType === 'date' ? '1995-07-15' : 'Alexander Soul'}
              required
            />
          </FormField>

          <Button type="button" variant="primary" size="lg" class="w-full cursor-pointer" id="calcSubmitBtn">
            {t('form.calculate', currentLocale)}
          </Button>

          <!-- Privacy Guarantee Notice -->
          <div class="text-center pt-2 border-t border-purple-100">
            <p class="text-[11px] font-medium text-purple-700 flex items-center justify-center gap-1">
              <span>🔒</span>
              <span><strong>Privacy Guarantee:</strong> Calculated locally in your browser. No data stored.</span>
            </p>
          </div>
        </form>
      </Card>

      <!-- Main Result Card with Deep Cosmic Gradient Contrast -->
      <div class="max-w-2xl mx-auto space-y-8">
        <Card variant="glow" class="text-center space-y-5 py-12 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-32 h-32 bg-amber-400/10 rounded-full blur-2xl"></div>
          <span class="text-xs uppercase tracking-widest text-amber-300 font-extrabold bg-white/10 px-4 py-1.5 rounded-full inline-block">
            ✨ {t('result.yourNumber', currentLocale)}
          </span>
          <div id="resultDisplay" class="text-7xl font-black text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-pink-300 to-amber-200 font-heading drop-shadow-md">
            1
          </div>
          <h2 id="resultTitle" class="text-3xl font-extrabold text-white">
            The Independent Leader & Pioneer
          </h2>
          <p id="resultSummary" class="text-purple-100 max-w-lg mx-auto text-base leading-relaxed font-medium">
            Vibration 1 signifies raw potential, individuality, leadership, and pioneering courage.
          </p>
        </Card>

        <!-- Strengths and Growth Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <Card variant="emerald" class="space-y-4">
            <h3 class="font-black text-white text-xl flex items-center gap-2 font-heading">
              <span class="text-2xl">🌟</span>
              <span>{t('result.strengths', currentLocale)}</span>
            </h3>
            <ul id="strengthsList" class="space-y-2 text-sm text-emerald-50">
              <li class="flex items-center gap-2.5 font-semibold bg-black/10 px-3 py-2 rounded-lg"><span class="w-2 h-2 rounded-full bg-amber-300"></span><span>Pioneering Vision</span></li>
              <li class="flex items-center gap-2.5 font-semibold bg-black/10 px-3 py-2 rounded-lg"><span class="w-2 h-2 rounded-full bg-amber-300"></span><span>High Ambition</span></li>
              <li class="flex items-center gap-2.5 font-semibold bg-black/10 px-3 py-2 rounded-lg"><span class="w-2 h-2 rounded-full bg-amber-300"></span><span>Self-Motivation</span></li>
            </ul>
          </Card>

          <Card variant="amber" class="space-y-4">
            <h3 class="font-black text-slate-950 text-xl flex items-center gap-2 font-heading">
              <span class="text-2xl">🌱</span>
              <span>{t('result.weaknesses', currentLocale)}</span>
            </h3>
            <ul id="weaknessesList" class="space-y-2 text-sm text-slate-950">
              <li class="flex items-center gap-2.5 font-bold bg-white/40 px-3 py-2 rounded-lg"><span class="w-2 h-2 rounded-full bg-purple-900"></span><span>Impatience</span></li>
              <li class="flex items-center gap-2.5 font-bold bg-white/40 px-3 py-2 rounded-lg"><span class="w-2 h-2 rounded-full bg-purple-900"></span><span>Dominance</span></li>
              <li class="flex items-center gap-2.5 font-bold bg-white/40 px-3 py-2 rounded-lg"><span class="w-2 h-2 rounded-full bg-purple-900"></span><span>Self-Reliance Overload</span></li>
            </ul>
          </Card>
        </div>

        <!-- How We Calculate / Methodology Section -->
        <Card variant="elevated" class="space-y-5 bg-white border border-purple-200">
          <h3 class="text-2xl font-bold text-purple-950 font-heading border-b border-purple-100 pb-3">
            📘 How We Calculate Your {t(currentCalc.titleKey, currentLocale).replace(' Calculator', '')}
          </h3>
          <p class="text-sm text-purple-900 leading-relaxed font-medium">
            At <strong>Souliography</strong>, our calculations use the classical <strong>Pythagorean Numerology System</strong>. Every letter of the alphabet corresponds to a numerical vibration from 1 to 9:
          </p>
          <div class="grid grid-cols-3 sm:grid-cols-9 gap-1 text-center font-mono text-xs font-bold bg-purple-50 p-3 rounded-xl border border-purple-200">
            <div class="p-1 bg-white rounded border border-purple-100"><span class="text-purple-600 block text-[10px]">1</span>A, J, S</div>
            <div class="p-1 bg-white rounded border border-purple-100"><span class="text-purple-600 block text-[10px]">2</span>B, K, T</div>
            <div class="p-1 bg-white rounded border border-purple-100"><span class="text-purple-600 block text-[10px]">3</span>C, L, U</div>
            <div class="p-1 bg-white rounded border border-purple-100"><span class="text-purple-600 block text-[10px]">4</span>D, M, V</div>
            <div class="p-1 bg-white rounded border border-purple-100"><span class="text-purple-600 block text-[10px]">5</span>E, N, W</div>
            <div class="p-1 bg-white rounded border border-purple-100"><span class="text-purple-600 block text-[10px]">6</span>F, O, X</div>
            <div class="p-1 bg-white rounded border border-purple-100"><span class="text-purple-600 block text-[10px]">7</span>G, P, Y</div>
            <div class="p-1 bg-white rounded border border-purple-100"><span class="text-purple-600 block text-[10px]">8</span>H, Q, Z</div>
            <div class="p-1 bg-white rounded border border-purple-100"><span class="text-purple-600 block text-[10px]">9</span>I, R</div>
          </div>
          <p class="text-xs text-purple-700 leading-relaxed">
            Values are summed and reduced down to a single digit between 1 and 9, preserving <strong>Master Numbers (11, 22, 33)</strong> as unreduced higher spiritual master frequencies.
          </p>
        </Card>

        <!-- E-E-A-T Author & Methodology Trust Box -->
        <div class="bg-purple-100/60 p-4 rounded-xl border border-purple-200/80 flex flex-wrap items-center justify-between gap-3 text-xs text-purple-900 font-medium">
          <div><strong>Written By:</strong> Souliography Research Team</div>
          <div><strong>Reviewed By:</strong> Esoteric Content Specialist</div>
          <div><strong>Methodology:</strong> Pythagorean System</div>
        </div>

        <!-- Related Numerology Calculators Grid -->
        <div class="pt-6 space-y-4">
          <h3 class="text-xl font-bold text-purple-950 font-heading text-center">
            Explore Related Numerology Calculators
          </h3>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
            {numerologyCalculators.slice(0, 6).map((calc: CalculatorConfig) => (
              <a
                href={`/${currentLocale}/calculators/${calc.slug}/`}
                class="p-3 bg-white rounded-xl border border-purple-200/80 shadow-xs hover:shadow-md hover:border-purple-400 transition-all flex items-center gap-2 text-xs font-bold text-purple-900"
              >
                <span>{calc.icon}</span>
                <span class="truncate">{t(calc.titleKey, currentLocale)}</span>
              </a>
            ))}
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Client-Side Interactive Calculation Engine -->
  <script is:inline define:vars={{ inputType: currentCalc.inputType, calcId: currentCalc.id, locale: currentLocale }}>
    const NUMEROLOGY_DATA = {
      1: {
        title: { en: 'The Independent Leader & Pioneer', ar: 'القائد المستقل والرواد' },
        summary: { en: 'Vibration 1 signifies raw potential, individuality, leadership, and pioneering courage.', ar: 'رمزية الرقم 1 تعبر عن القيادة، الاستقلالية، والشجاعة في الابتكار.' },
        strengths: { en: ['Pioneering Vision', 'High Ambition', 'Self-Motivation', 'Originality'], ar: ['الرؤية الابتكارية', 'الطموح العالي', 'التحفيز الذاتي', 'الأصالة'] },
        weaknesses: { en: ['Impatience', 'Dominance', 'Self-Reliance Overload'], ar: ['قلة الصبر', 'الهيمنة', 'الإفراط في الاعتماد على الذات'] }
      },
      2: {
        title: { en: 'The Harmony Weaver & Diplomat', ar: 'منسق التناغم والدبلوماسي' },
        summary: { en: 'Vibration 2 embodies empathy, cooperation, partnership, and subtle intuitive strength.', ar: 'يعبر الرقم 2 عن التعاطف، التعاون، والشراكة العاطفية الروحية.' },
        strengths: { en: ['Diplomacy', 'Deep Empathy', 'Patience', 'Intuitive Guidance'], ar: ['الدبلوماسية', 'التعاطف العميق', 'الصبر', 'الإلهام الحدسي'] },
        weaknesses: { en: ['Over-Sensitivity', 'Conflict Avoidance', 'Hesitation'], ar: ['الحساسية المفرطة', 'تجنب المواجهة', 'التردد'] }
      },
      3: {
        title: { en: 'The Creative Catalyst & Communicator', ar: 'المحفز المبدع والمتحدث' },
        summary: { en: 'Vibration 3 represents self-expression, joy, artistic talent, and magnetic charisma.', ar: 'يرمز الرقم 3 إلى التعبير عن الذات، البهجة، والإبداع الفني والجاذبية.' },
        strengths: { en: ['Artistic Brilliance', 'Charisma', 'Optimism', 'Inspiring Speech'], ar: ['الإبداع الفني', 'الجاذبية', 'التفاؤل', 'التأثير الكلامي'] },
        weaknesses: { en: ['Scattered Energy', 'Superficiality', 'Mood Swings'], ar: ['تشتت الطاقة', 'السطحية', 'تقلب المزاج'] }
      },
      4: {
        title: { en: 'The Master Builder & Foundation', ar: 'البناء الخبير وركيزة الاستقرار' },
        summary: { en: 'Vibration 4 stands for stability, systematic work, discipline, and practical wisdom.', ar: 'يعبر الرقم 4 عن الاستقرار، العمل المنظم، الانضباط والحكمة العملية.' },
        strengths: { en: ['Unshakable Loyalty', 'Systematic Order', 'Practicality', 'Perseverance'], ar: ['الولاء الراسخ', 'النظام', 'الواقعية', 'المثابرة'] },
        weaknesses: { en: ['Rigidity', 'Resistance to Change', 'Over-Cautiousness'], ar: ['الجمود', 'مقاومة التغيير', 'الحذر المفرط'] }
      },
      5: {
        title: { en: 'The Freedom Seeker & Explorer', ar: 'باحث الحرية والمستكشف' },
        summary: { en: 'Vibration 5 brings adaptability, love for freedom, adventurous spirit, and versatility.', ar: 'يمثل الرقم 5 التكيف، حب الحرية، روح المغامرة والمرونة عالية المستوى.' },
        strengths: { en: ['Adaptability', 'Courageous Curiosity', 'Resourcefulness', 'Versatility'], ar: ['التكيف', 'الفضول الشجاع', 'الدهاء', 'تعدد المهارات'] },
        weaknesses: { en: ['Restlessness', 'Impulsiveness', 'Lack of Focus'], ar: ['القلق الدائم', 'الاندفاع', 'ضعف التركيز'] }
      },
      6: {
        title: { en: 'The Nurturing Guardian & Healer', ar: 'المربي الراعي والشافي' },
        summary: { en: 'Vibration 6 represents unconditional love, family responsibility, harmony, and healing.', ar: 'يرمز الرقم 6 إلى الحب غير المشروط، المسؤولية العائلية والتناغم الشفائي.' },
        strengths: { en: ['Compassion', 'Healing Energy', 'Protective Care', 'Artistic Eye'], ar: ['الرحمة', 'طاقة الشفاء', 'الحماية', 'الذوق الفني'] },
        weaknesses: { en: ['Self-Sacrifice', 'Meddling', 'Perfectionism'], ar: ['التضحية المفرطة', 'التدخل', 'المثالية'] }
      },
      7: {
        title: { en: 'The Mystic Seeker & Philosopher', ar: 'الباحث الباطني والفيلسوف' },
        summary: { en: 'Vibration 7 embodies deep spiritual analysis, wisdom, introspection, and truth-seeking.', ar: 'يمثل الرقم 7 التحليل الروحي العميق، الحكمة، والتأمل الباطني في الحقائق.' },
        strengths: { en: ['Analytical Mind', 'Intuitive Wisdom', 'Spiritual Insight', 'Perception'], ar: ['العقل التحليلي', 'الحكمة الحدسية', 'البصيرة الروحية', 'الإدراك'] },
        weaknesses: { en: ['Isolation', 'Skepticism', 'Detachment'], ar: ['العزلة', 'التشكيك', 'الانفصال العاطفي'] }
      },
      8: {
        title: { en: 'The Power Strategist & Authority', ar: 'المخطط الاستراتيجي والقوة' },
        summary: { en: 'Vibration 8 commands material mastery, executive power, karmic balance, and ambition.', ar: 'يعبر الرقم 8 عن التمكن المادي، القوة التنفيذية، والتوازن الكارمي والطموح.' },
        strengths: { en: ['Executive Mastery', 'Financial Vision', 'Resilience', 'Karmic Mastery'], ar: ['التمكن التنفيذي', 'الرؤية المالية', 'القدرة على النهوض', 'الاتزان الكارمي'] },
        weaknesses: { en: ['Workaholism', 'Material Stress', 'Control Tendencies'], ar: ['الإدمان على العمل', 'الضغط المادي', 'الرغبة في السيطرة'] }
      },
      9: {
        title: { en: 'The Universal Humanitarian & Sage', ar: 'الإنساني العالمي والحكيم' },
        summary: { en: 'Vibration 9 represents completion, universal compassion, spiritual wisdom, and selfless service.', ar: 'يرمز الرقم 9 إلى الاكتمل، الرحمة العالمية، الحكمة الروحية والخدمة الإنسانية.' },
        strengths: { en: ['Universal Empathy', 'Broad Vision', 'Selfless Giving', 'Artistic Mastery'], ar: ['التعاطف الشامل', 'الرؤية الواسعة', 'العطاء', 'الإبداع الفني'] },
        weaknesses: { en: ['Emotional Burden', 'Over-idealism', 'Difficulty Letting Go'], ar: ['الثقل العاطفي', 'المثالية المفرطة', 'صعوبة التخلي'] }
      }
    };

    function reduceNum(val) {
      let sum = val;
      while (sum > 9 && sum !== 11 && sum !== 22 && sum !== 33) {
        sum = sum.toString().split('').reduce((a, b) => a + (parseInt(b, 10) || 0), 0);
      }
      return sum || 1;
    }

    function calculateVal(val) {
      if (!val) return 1;
      if (inputType === 'date') {
        const digits = val.replace(/\D/g, '');
        if (!digits) return 1;
        const total = digits.split('').reduce((a, b) => a + parseInt(b, 10), 0);
        return reduceNum(total);
      } else {
        const clean = val.toLowerCase().replace(/[^a-z]/g, '');
        if (!clean) return 1;
        const letterMap = { a:1,b:2,c:3,d:4,e:5,f:6,g:7,h:8,i:9,j:1,k:2,l:3,m:4,n:5,o:6,p:7,q:8,r:9,s:1,t:2,u:3,v:4,w:5,x:6,y:7,z:8 };
        let sum = 0;
        for (let i = 0; i < clean.length; i++) {
          sum += letterMap[clean[i]] || 0;
        }
        return reduceNum(sum);
      }
    }

    function updateDOM(num) {
      const displayNum = num > 9 && num !== 11 && num !== 22 && num !== 33 ? (num % 9 || 9) : num;
      const data = NUMEROLOGY_DATA[displayNum] || NUMEROLOGY_DATA[1];
      const lang = locale || 'en';

      const resElem = document.getElementById('resultDisplay');
      const titleElem = document.getElementById('resultTitle');
      const sumElem = document.getElementById('resultSummary');
      const strengthsUl = document.getElementById('strengthsList');
      const weaknessesUl = document.getElementById('weaknessesList');

      if (resElem) resElem.textContent = num;
      if (titleElem) titleElem.textContent = data.title[lang] || data.title['en'];
      if (sumElem) sumElem.textContent = data.summary[lang] || data.summary['en'];

      const sList = data.strengths[lang] || data.strengths['en'];
      const wList = data.weaknesses[lang] || data.weaknesses['en'];

      if (strengthsUl) {
        strengthsUl.innerHTML = sList.map(item => 
          `<li class="flex items-center gap-2.5 font-semibold bg-black/10 px-3 py-2 rounded-lg"><span class="w-2 h-2 rounded-full bg-amber-300"></span><span>${item}</span></li>`
        ).join('');
      }

      if (weaknessesUl) {
        weaknessesUl.innerHTML = wList.map(item => 
          `<li class="flex items-center gap-2.5 font-bold bg-white/40 px-3 py-2 rounded-lg"><span class="w-2 h-2 rounded-full bg-purple-900"></span><span>${item}</span></li>`
        ).join('');
      }
    }

    function bindEvents() {
      const input = document.getElementById('calcInput');
      const btn = document.getElementById('calcSubmitBtn');

      function trigger() {
        if (!input) return;
        const val = input.value;
        const res = calculateVal(val);
        updateDOM(res);
      }

      if (btn) {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          trigger();
        });
      }

      if (input) {
        input.addEventListener('input', trigger);
        input.addEventListener('change', trigger);
        input.addEventListener('keyup', trigger);
      }

      trigger();
    }

    window.addEventListener('load', bindEvents);
    document.addEventListener('DOMContentLoaded', bindEvents);
    bindEvents();
  </script>
</BaseLayout>
