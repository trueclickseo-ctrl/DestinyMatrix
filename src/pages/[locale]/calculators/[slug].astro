---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/common/Breadcrumbs.astro';
import CalculationBreakdown from '../../../components/common/CalculationBreakdown.astro';
import DisclaimerBox from '../../../components/common/DisclaimerBox.astro';
import MethodologyBox from '../../../components/common/MethodologyBox.astro';
import { numerologyCalculators, type CalculatorConfig } from '../../../config/calculators.config';
import { supportedLocales } from '../../../config/locales.config';
import { t } from '../../../i18n';
import { SchemaEngine } from '../../../engines/schema';

// Import pure calculation engines
import { calculateLifePath } from '../../../engines/calculator/life-path/calculation';
import { calculateDestinyNumber } from '../../../engines/calculator/name/destiny';

export function getStaticPaths() {
  const paths = [];
  for (const locale of supportedLocales) {
    for (const calc of numerologyCalculators) {
      paths.push({ params: { locale, slug: calc.slug } });
    }
  }
  return paths;
}

const { locale = 'en', slug } = Astro.params;
const currentLocale = locale;

const currentCalc = numerologyCalculators.find((c: CalculatorConfig) => c.slug === slug) || numerologyCalculators[0];

const appSchema = SchemaEngine.generateSoftwareApplicationSchema(
  t(currentCalc.titleKey, currentLocale),
  t(currentCalc.descKey, currentLocale),
  `https://souliography.com/${currentLocale}/calculators/${currentCalc.slug}/`
);

const breadcrumbItems = [
  { label: 'Calculators', href: `/${currentLocale}/` },
  { label: t(currentCalc.titleKey, currentLocale) },
];

// Perform initial server-side calculation for default preview
const initialLifePath = calculateLifePath('1995-07-15');
const initialNameRes = calculateDestinyNumber('Alexander Soul');
---

<BaseLayout
  title={t(currentCalc.titleKey, currentLocale)}
  description={t(currentCalc.descKey, currentLocale)}
  locale={currentLocale}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(appSchema)} />

  <!-- Hero Section with Reference Library Header Styling -->
  <section class="bg-[#231530] text-white py-12 px-4 border-b-2 border-[#C4A052]">
    <div class="max-w-4xl mx-auto space-y-4 text-center">
      <Breadcrumbs items={breadcrumbItems} locale={currentLocale} />

      <span class="text-xs uppercase tracking-widest text-[#C4A052] font-mono font-bold bg-white/10 px-3 py-1 rounded inline-block border border-[#C4A052]/40">
        Interactive Numerology Calculator
      </span>
      <h1 class="text-4xl sm:text-5xl font-serif font-bold text-amber-100">
        {t(currentCalc.titleKey, currentLocale)}
      </h1>
      <p class="text-purple-200 max-w-xl mx-auto text-base sm:text-lg font-serif">
        {t(currentCalc.descKey, currentLocale)}
      </p>

      <!-- Trust Badges Bar -->
      <div class="pt-3 flex flex-wrap justify-center items-center gap-3 text-xs font-semibold text-amber-200 font-mono">
        <span class="bg-white/10 px-3 py-1 rounded border border-[#C4A052]/30">✓ Classical Pythagorean System</span>
        <span class="bg-white/10 px-3 py-1 rounded border border-[#C4A052]/30">✓ Localized Browser Processing</span>
        <span class="bg-white/10 px-3 py-1 rounded border border-[#C4A052]/30">✓ Master Numbers Preserved (11, 22, 33)</span>
      </div>
    </div>
  </section>

  <!-- Interactive Calculator & Calculation Breakdown Area -->
  <div class="bg-[#FBF9F5] py-10 px-4 text-[#1C1625]">
    <div class="max-w-4xl mx-auto space-y-8">

      <!-- Form Section in Parchment Reference Card -->
      <div class="ref-card max-w-md mx-auto p-6 space-y-4 border-t-4 border-t-[#C4A052]">
        <h2 class="text-lg font-serif font-bold text-[#1C1625] border-b border-[#D8D0C5] pb-2 text-center">
          Enter Details for Calculation
        </h2>
        <form id="calculatorForm" class="space-y-4" action="javascript:void(0);">
          <div class="space-y-1">
            <label htmlFor="calcInput" class="text-xs font-bold text-[#1C1625] block">
              {currentCalc.inputType === 'date' ? t('form.birthDate', currentLocale) : currentCalc.inputType === 'address' ? t('form.address', currentLocale) : currentCalc.inputType === 'phone' ? t('form.phone', currentLocale) : currentCalc.inputType === 'plate' ? t('form.plate', currentLocale) : t('form.fullName', currentLocale)}
            </label>
            <input
              type={currentCalc.inputType === 'date' ? 'date' : 'text'}
              id="calcInput"
              name="calcInput"
              value={currentCalc.inputType === 'date' ? '1995-07-15' : 'Alexander Soul'}
              required
              class="w-full px-3 py-2 rounded bg-[#FFFFFF] border border-[#D8D0C5] text-xs font-mono text-[#1C1625] focus:outline-none focus:border-[#C4A052]"
            />
          </div>

          <button type="button" class="btn-retro w-full text-center" id="calcSubmitBtn">
            {t('form.calculate', currentLocale)}
          </button>

          <p class="text-[11px] text-[#524B5A] text-center pt-1">
            🔒 Privacy Guarantee: Calculated locally in your browser. No personal data is stored.
          </p>
        </form>
      </div>

      <!-- Main Result Card & Calculation Breakdown -->
      <div class="max-w-2xl mx-auto space-y-6">
        
        <div class="ref-card p-8 text-center space-y-4 border-2 border-[#C4A052] bg-[#FFFFFF]">
          <span class="text-xs uppercase tracking-widest text-[#9E7B3B] font-mono font-bold">
            ✨ {t('result.yourNumber', currentLocale)}
          </span>
          <div id="resultDisplay" class="text-6xl sm:text-7xl font-serif font-bold text-[#231530] font-mono">
            {currentCalc.inputType === 'date' ? initialLifePath.lifePathNumber : initialNameRes.destinyNumber}
          </div>
          <h2 id="resultTitle" class="text-2xl font-serif font-bold text-[#1C1625]">
            Calculated Vibration & Archetype
          </h2>
          <p id="resultSummary" class="text-xs text-[#524B5A] max-w-lg mx-auto leading-relaxed">
            Your input yields the numerical vibration shown above. Explore the full calculation breakdown and methodology below.
          </p>
        </div>

        <!-- Dynamic Calculation Breakdown Component -->
        <CalculationBreakdown
          title={`Step-by-Step Calculation Breakdown for ${t(currentCalc.titleKey, currentLocale)}`}
          steps={currentCalc.inputType === 'date' ? initialLifePath.breakdown : initialNameRes.breakdown}
          finalResult={currentCalc.inputType === 'date' ? initialLifePath.lifePathNumber : initialNameRes.destinyNumber}
          isMasterNumber={currentCalc.inputType === 'date' ? initialLifePath.isMasterNumber : initialNameRes.isMasterNumber}
        />

        <!-- Methodology Disclosures -->
        <MethodologyBox
          title="Pythagorean Numerology Methodology"
          systemName="Pythagorean Numerical Transliteration & Period Reduction"
          summary="Calculations follow classical Pythagorean period-reduction rules to reduce component numbers while preserving Master Numbers (11, 22, 33)."
          whyResultMayDiffer="Different numerology tools calculate numbers using either period reduction or raw digit summing. Souliography uses period reduction to preserve intermediate master frequencies."
        />

        <DisclaimerBox />

      </div>

    </div>
  </div>
</BaseLayout>
