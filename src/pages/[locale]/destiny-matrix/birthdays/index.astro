---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { supportedLocales } from '../../../../config/locales.config';
import { t } from '../../../../i18n';

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const { locale = 'en' } = Astro.params;

const months = [
  { name: 'January', slug: 'january', days: 31 },
  { name: 'February', slug: 'february', days: 29 },
  { name: 'March', slug: 'march', days: 31 },
  { name: 'April', slug: 'april', days: 30 },
  { name: 'May', slug: 'may', days: 31 },
  { name: 'June', slug: 'june', days: 30 },
  { name: 'July', slug: 'july', days: 31 },
  { name: 'August', slug: 'august', days: 31 },
  { name: 'September', slug: 'september', days: 30 },
  { name: 'October', slug: 'october', days: 31 },
  { name: 'November', slug: 'november', days: 30 },
  { name: 'December', slug: 'december', days: 31 },
];
---

<BaseLayout
  title="365 Birthdate Destiny Matrix Directory | Souliography"
  description="Explore the complete 365-day Destiny Matrix reading directory. Find deep personal archetype, money line, and soul vocation readings for every birthdate."
  locale={locale}
>
  <section class="bg-gradient-to-b from-stone-900 via-purple-950 to-slate-950 text-white py-16 px-4 text-center">
    <div class="max-w-4xl mx-auto space-y-4">
      <span class="text-xs uppercase tracking-widest text-amber-400 font-extrabold bg-white/10 px-4 py-1.5 rounded-full inline-block">
        365 BIRTHDATE INTELLIGENCE DIRECTORY
      </span>
      <h1 class="text-4xl sm:text-6xl font-serif font-bold text-amber-200">
        Birthdate Destiny Matrix Directory
      </h1>
      <p class="text-purple-200 max-w-2xl mx-auto text-base sm:text-lg">
        Select your birth date below to access your complete Destiny Matrix profile, soul purpose, money channels, and relationship resonance.
      </p>
    </div>
  </section>

  <div class="bg-stone-50 py-12 px-4">
    <div class="max-w-6xl mx-auto space-y-10">
      {months.map((month) => (
        <div class="bg-white rounded-2xl p-6 border border-stone-200 shadow-sm space-y-4">
          <h2 class="text-2xl font-serif font-bold text-stone-900 border-b border-stone-100 pb-2">
            {month.name} Destiny Matrix Readings
          </h2>
          <div class="flex flex-wrap gap-2">
            {Array.from({ length: month.days }, (_, i) => i + 1).map((day) => (
              <a
                href={`/${locale}/destiny-matrix/birthdays/${month.slug}-${day}/`}
                class="px-3 py-1.5 bg-purple-50 hover:bg-purple-600 text-purple-900 hover:text-white rounded-lg text-xs font-bold transition-all border border-purple-100"
              >
                {month.name} {day}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
