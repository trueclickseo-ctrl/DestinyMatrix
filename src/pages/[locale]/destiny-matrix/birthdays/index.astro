---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/common/Breadcrumbs.astro';
import { getAllBirthdayProfiles } from '../../../../data/birthdays';
import { supportedLocales } from '../../../../config/locales.config';
import { t } from '../../../../i18n';

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const { locale = 'en' } = Astro.params;

const breadcrumbs = [
  { label: 'Home', href: `/${locale}/` },
  { label: t('nav.destinyMatrix', locale), href: `/${locale}/` },
  { label: t('nav.birthdays', locale) },
];

const months = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December'
];

const allProfiles = getAllBirthdayProfiles();
---

<BaseLayout
  title={`${t('nav.birthdays', locale)} Directory | Souliography`}
  description="365-day birthday reference directory mapping daily Arcana frequencies, seasonal vibrations, and personal reflections."
  locale={locale}
>
  <section class="bg-[#231530] text-white py-12 px-4 border-b-2 border-[#C4A052]">
    <div class="max-w-5xl mx-auto space-y-4 text-center">
      <Breadcrumbs items={breadcrumbs} locale={locale} />
      <span class="text-xs uppercase tracking-widest text-[#C4A052] font-mono font-bold bg-white/10 px-3 py-1 rounded inline-block border border-[#C4A052]/40">
        365-Day Vibrational Directory
      </span>
      <h1 class="text-4xl sm:text-5xl font-serif font-bold text-amber-100">
        {t('nav.birthdays', locale)} Directory
      </h1>
      <p class="text-purple-200 max-w-2xl mx-auto text-sm sm:text-base font-serif">
        Browse by calendar month to find your birth date's core Arcana alignment and vibration.
      </p>
    </div>
  </section>

  <main class="py-12 px-4 max-w-6xl mx-auto space-y-12 text-[#1C1625]">

    <!-- Month Navigation Quick Bar -->
    <div class="ref-card p-6 bg-white border border-[#D8D0C5] space-y-4">
      <h2 class="text-lg font-serif font-bold text-[#231530] border-b border-[#D8D0C5] pb-2 text-center">
        Jump to Month
      </h2>
      <div class="flex flex-wrap justify-center gap-2 text-xs font-mono font-bold">
        {months.map((m) => (
          <a
            href={`#month-${m.toLowerCase()}`}
            class="px-3 py-1.5 rounded bg-[#FBF9F5] border border-[#D8D0C5] text-[#231530] hover:border-[#C4A052] hover:text-[#9E7B3B] transition-colors"
          >
            {m}
          </a>
        ))}
      </div>
    </div>

    <!-- Month Sections with Date Grids -->
    {months.map((monthName) => {
      const monthProfiles = allProfiles.filter(p => p.formattedDate.startsWith(monthName));

      return (
        <div id={`month-${monthName.toLowerCase()}`} class="space-y-4 pt-4">
          <div class="border-b-2 border-[#C4A052] pb-2 flex items-center justify-between">
            <h2 class="text-2xl font-serif font-bold text-[#231530]">
              📅 {monthName} Birthdays
            </h2>
            <span class="text-xs font-mono text-[#9E7B3B] font-bold">
              {monthProfiles.length} Days
            </span>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8 gap-3">
            {monthProfiles.map((b) => (
              <a
                href={`/${locale}/destiny-matrix/birthdays/${b.slug}/`}
                class="ref-card p-3 bg-white border border-[#D8D0C5] hover:border-[#C4A052] transition-colors rounded text-center space-y-1 group block"
              >
                <span class="text-sm font-serif font-bold text-[#231530] group-hover:text-[#9E7B3B] block">
                  {b.formattedDate}
                </span>
                <span class="text-[10px] font-mono text-[#9E7B3B] block">
                  Arcana {b.primaryArcanaNum}
                </span>
              </a>
            ))}
          </div>
        </div>
      );
    })}

  </main>
</BaseLayout>
