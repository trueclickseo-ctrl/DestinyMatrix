---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/common/Breadcrumbs.astro';
import DisclaimerBox from '../../../../components/common/DisclaimerBox.astro';
import MethodologyBox from '../../../../components/common/MethodologyBox.astro';
import { getBirthdayProfile, getAllBirthdayProfiles } from '../../../../data/birthdays';
import { supportedLocales } from '../../../../config/locales.config';
import { t } from '../../../../i18n';

export function getStaticPaths() {
  const allProfiles = getAllBirthdayProfiles();
  const paths = [];

  for (const locale of supportedLocales) {
    for (const profile of allProfiles) {
      paths.push({
        params: {
          locale,
          dateSlug: profile.slug,
        },
      });
    }
  }
  return paths;
}

const { locale = 'en', dateSlug } = Astro.params;
const currentLocale = locale;

const allProfiles = getAllBirthdayProfiles();
const currentIndex = allProfiles.findIndex((p) => p.slug === dateSlug);
const validIndex = currentIndex >= 0 ? currentIndex : 0;
const profile = allProfiles[validIndex] || allProfiles[0];

// Get ±3 adjacent dates
const totalDates = allProfiles.length;
const adjacentDates = [];
for (let offset = -3; offset <= 3; offset++) {
  if (offset === 0) continue;
  let idx = (validIndex + offset) % totalDates;
  if (idx < 0) idx += totalDates;
  adjacentDates.push(allProfiles[idx]);
}

const pageTitle = `${profile.formattedDate} Destiny Matrix Profile & Soul Vibration | Souliography`;
const pageDesc = `Detailed Destiny Matrix birthday guide for ${profile.formattedDate}. Discover personal purpose, Arcana ${profile.primaryArcanaNum} (${profile.primaryArcana.name}) influences, seasonal context, and practical reflection questions.`;

const breadcrumbItems = [
  { label: 'Destiny Matrix', href: `/${currentLocale}/` },
  { label: 'Birthdays Directory', href: `/${currentLocale}/destiny-matrix/birthdays/` },
  { label: profile.formattedDate },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `https://souliography.com/${currentLocale}/` },
    { '@type': 'ListItem', position: 2, name: 'Birthdays', item: `https://souliography.com/${currentLocale}/destiny-matrix/birthdays/` },
    { '@type': 'ListItem', position: 3, name: profile.formattedDate, item: `https://souliography.com/${currentLocale}/destiny-matrix/birthdays/${dateSlug}/` },
  ],
};
---

<BaseLayout title={pageTitle} description={pageDesc} locale={currentLocale}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Hero Header Panel -->
  <section class="bg-[#231530] text-white py-12 px-4 border-b-2 border-[#C4A052]">
    <div class="max-w-4xl mx-auto space-y-4">
      <Breadcrumbs items={breadcrumbItems} locale={currentLocale} />

      <span class="text-xs uppercase tracking-widest text-[#C4A052] font-mono font-bold bg-white/10 px-3 py-1 rounded inline-block border border-[#C4A052]/40">
        365 BIRTHDATE DESTINY MATRIX REFERENCE
      </span>
      <h1 class="text-4xl sm:text-5xl font-serif font-bold text-amber-100">
        {profile.formattedDate} Destiny Matrix Profile
      </h1>
      <p class="text-purple-200 max-w-xl text-base sm:text-lg font-serif">
        Primary birth vibration governed by <strong>Arcana {profile.primaryArcanaNum}: {profile.primaryArcana.name}</strong>.
      </p>
    </div>
  </section>

  <!-- Main Content Body -->
  <div class="bg-[#FBF9F5] py-10 px-4 text-[#1C1625]">
    <div class="max-w-4xl mx-auto space-y-8">

      <!-- Core Arcana Integration Card -->
      <article class="ref-card p-6 sm:p-8 space-y-4">
        <div class="flex flex-wrap items-center justify-between border-b border-[#D8D0C5] pb-3 gap-2">
          <h2 class="text-2xl font-serif font-bold text-[#1C1625]">
            Birth Archetype: Arcana {profile.primaryArcanaNum} ({profile.primaryArcana.name})
          </h2>
          <a
            href={`/${currentLocale}/destiny-matrix/arcana/${profile.primaryArcanaNum}-${profile.primaryArcana.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}/`}
            class="text-xs font-bold text-[#231530] hover:text-[#9E7B3B] font-mono underline"
          >
            Read Arcana {profile.primaryArcanaNum} Encyclopedia Guide →
          </a>
        </div>
        <p class="text-sm text-[#1C1625] leading-relaxed font-normal">
          Individuals born on <strong>{profile.formattedDate}</strong> carry the foundational frequency of <strong>{profile.primaryArcana.name}</strong> ({profile.primaryArcana.archetype}). This vibration influences your primary approach to leadership, creative projects, and personal decisions.
        </p>

        <!-- Seasonal & Day Context -->
        <div class="p-4 bg-[#F5F2EB] rounded border border-[#D8D0C5] space-y-1 pt-3">
          <h3 class="text-xs font-mono font-bold uppercase text-[#9E7B3B] tracking-wider">Seasonal & Calendar Context</h3>
          <p class="text-xs text-[#524B5A] leading-relaxed">{profile.seasonalContext}</p>
          <p class="text-xs text-[#1C1625] leading-relaxed pt-1 font-medium">{profile.dayVibrationNote}</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          <div class="p-4 bg-[#FFFFFF] rounded border border-emerald-300 space-y-1">
            <h4 class="font-bold text-emerald-950 text-xs uppercase tracking-wider font-mono">Constructive High Frequency</h4>
            <p class="text-xs text-emerald-900 leading-relaxed">{profile.primaryArcana.positiveExpression}</p>
          </div>
          <div class="p-4 bg-[#FFFFFF] rounded border border-rose-300 space-y-1">
            <h4 class="font-bold text-rose-950 text-xs uppercase tracking-wider font-mono">Shadow Challenges</h4>
            <p class="text-xs text-rose-900 leading-relaxed">{profile.primaryArcana.shadowExpression}</p>
          </div>
        </div>
      </article>

      <!-- Career Vocation & Money Channel -->
      <article class="ref-card p-6 sm:p-8 space-y-4">
        <h3 class="text-xl font-serif font-bold text-[#1C1625] border-b border-[#D8D0C5] pb-2">
          Vocation & Financial Flow for {profile.formattedDate}
        </h3>
        <p class="text-xs text-[#524B5A] leading-relaxed">
          <strong>Ideal Vocation Alignment:</strong> {profile.primaryArcana.careerGuidance}
        </p>
        <p class="text-xs text-[#524B5A] leading-relaxed">
          <strong>Money Line Activation:</strong> {profile.primaryArcana.moneyChannel}
        </p>
      </article>

      <!-- Practical Self-Reflection Prompts -->
      <article class="ref-card p-6 sm:p-8 space-y-4 bg-[#231530] text-white border-2 border-[#C4A052]">
        <h3 class="text-xl font-serif font-bold text-[#C4A052] flex items-center gap-2">
          <span>🔮</span>
          <span>Self-Reflection Questions for {profile.formattedDate}</span>
        </h3>
        <ul class="space-y-2 pt-1">
          {profile.reflectionQuestions.map((q) => (
            <li class="flex items-start gap-2.5 text-xs text-stone-200">
              <span class="text-[#C4A052] font-bold">›</span>
              <span>{q}</span>
            </li>
          ))}
        </ul>
      </article>

      <!-- Interactive Calculator Callout -->
      <div class="ref-card p-6 bg-[#F5F2EB] border border-[#C4A052] flex flex-wrap items-center justify-between gap-4">
        <div class="space-y-1 max-w-xl">
          <h3 class="text-lg font-serif font-bold text-[#1C1625]">Calculate Your Complete Birth Year Matrix</h3>
          <p class="text-xs text-[#524B5A] leading-relaxed">
            Combine your birth day ({profile.formattedDate}) with your birth year in our live calculator for full 7 Chakra energy tables, personal money lines, and AI interpretation.
          </p>
        </div>
        <a href={`/${currentLocale}/`} class="btn-retro inline-block">
          Open Destiny Matrix Calculator →
        </a>
      </div>

      <!-- Adjacent Dates Navigation Section -->
      <div class="ref-card p-6 space-y-4">
        <div class="flex items-center justify-between border-b border-[#D8D0C5] pb-3">
          <h3 class="text-base font-serif font-bold text-[#1C1625]">
            Explore Nearby Birthdates
          </h3>
          <a href={`/${currentLocale}/destiny-matrix/birthdays/`} class="text-xs font-bold text-[#231530] hover:underline font-mono">
            View All 365 Dates →
          </a>
        </div>
        <div class="flex flex-wrap gap-2 pt-1">
          {adjacentDates.map((item) => (
            <a
              href={`/${currentLocale}/destiny-matrix/birthdays/${item.slug}/`}
              class="px-3 py-1.5 bg-[#F5F2EB] hover:bg-[#231530] text-[#1C1625] hover:text-[#C4A052] rounded text-xs font-bold transition-all border border-[#D8D0C5]"
            >
              {item.formattedDate}
            </a>
          ))}
        </div>
      </div>

      <MethodologyBox
        title="Birthday Profile Methodology"
        systemName="Natalia Ladini 22 Arcana Birth Date Mapping"
        summary="Calculations map your birth day to its corresponding Arcana frequency (1-22) within the Destiny Matrix framework."
        disclosures="Birth date profiles serve as self-reflection tools."
      />

      <DisclaimerBox />

    </div>
  </div>
</BaseLayout>
