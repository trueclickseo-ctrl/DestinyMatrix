---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/common/Breadcrumbs.astro';
import { MAJOR_ARCANA_DATABASE } from '../../../../data/arcana';
import { supportedLocales } from '../../../../config/locales.config';
import { t } from '../../../../i18n';

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const { locale = 'en' } = Astro.params;

const breadcrumbs = [
  { label: t('nav.home', locale), href: `/${locale}/` },
  { label: `${t('nav.arcana', locale)} Directory` },
];

const arcanaItems = Object.keys(MAJOR_ARCANA_DATABASE).map((key) => {
  const num = parseInt(key, 10);
  const entry = MAJOR_ARCANA_DATABASE[num];
  const slugName = entry.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
  return {
    number: num,
    title: entry.name,
    archetype: entry.archetype,
    summary: entry.meaning,
    slug: `${num}-${slugName}`,
  };
});
---

<BaseLayout
  title={`${t('nav.arcana', locale)} Encyclopedia | Souliography`}
  description="Explore the complete 22 Major Arcana reference library in Natalia Ladini's Destiny Matrix system."
  locale={locale}
>
  <section class="bg-[#231530] text-white py-12 px-4 border-b-2 border-[#C4A052]">
    <div class="max-w-5xl mx-auto space-y-4 text-center">
      <Breadcrumbs items={breadcrumbs} locale={locale} />
      <span class="text-xs uppercase tracking-widest text-[#C4A052] font-mono font-bold bg-white/10 px-3 py-1 rounded inline-block border border-[#C4A052]/40">
        Natalia Ladini 22 Arcana System
      </span>
      <h1 class="text-4xl sm:text-5xl font-serif font-bold text-amber-100">
        {t('nav.arcana', locale)} Encyclopedia
      </h1>
      <p class="text-purple-200 max-w-2xl mx-auto text-sm sm:text-base font-serif">
        Complete reference directory for all 22 Major Arcana archetypes mapped within the Matrix of Destiny.
      </p>
    </div>
  </section>

  <main class="py-12 px-4 max-w-6xl mx-auto space-y-8 text-[#1C1625]">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      {arcanaItems.map((arcana) => (
        <a
          href={`/${locale}/destiny-matrix/arcana/${arcana.slug}/`}
          class="ref-card p-5 bg-white border border-[#D8D0C5] hover:border-[#C4A052] transition-colors rounded space-y-3 flex flex-col justify-between group"
        >
          <div class="space-y-2">
            <div class="flex items-center justify-between border-b border-[#D8D0C5] pb-2">
              <span class="font-serif font-bold text-lg text-[#9E7B3B]">Arcana {arcana.number}</span>
              <span class="text-xl">✨</span>
            </div>
            <h2 class="font-serif font-bold text-base text-[#231530] group-hover:text-[#9E7B3B] transition-colors">
              {arcana.title}
            </h2>
            <p class="text-xs text-[#524B5A] line-clamp-3 leading-relaxed">
              {arcana.summary}
            </p>
          </div>
          <div class="pt-2 text-[11px] font-bold text-[#9E7B3B] group-hover:underline">
            Read Full Archetype Guide →
          </div>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>
