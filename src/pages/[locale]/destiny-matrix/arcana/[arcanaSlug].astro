---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { MAJOR_ARCANA_DATABASE, getLocalizedArcanaEntry } from '../../../../data/arcana';
import { supportedLocales } from '../../../../config/locales.config';

export function getStaticPaths() {
  const paths = [];

  for (const locale of supportedLocales) {
    for (let i = 1; i <= 22; i++) {
      paths.push({
        params: {
          locale,
          arcanaSlug: `${i}-${(MAJOR_ARCANA_DATABASE[i]?.name || 'Arcana').toLowerCase().replace(/\s+/g, '-')}`
        }
      });
    }
  }
  return paths;
}

const { locale = 'en', arcanaSlug } = Astro.params;
const arcanaNum = parseInt((arcanaSlug || '1').split('-')[0], 10);
const arcanaData = getLocalizedArcanaEntry(arcanaNum, locale);

const pageTitle = `${arcanaData.name} (Arcana ${arcanaData.number}): Comprehensive Meaning & Encyclopedia Guide`;
const pageDesc = `Detailed 2,500+ word encyclopedia guide for ${arcanaData.name} in Destiny Matrix. Discover positive & shadow expressions, career, love compatibility, money channel, and chakra connections.`;
---

<BaseLayout title={pageTitle} description={pageDesc} locale={locale}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-stone-900 via-purple-950 to-slate-950 text-white py-16 px-4">
    <div class="max-w-4xl mx-auto text-center space-y-4">
      <span class="text-xs uppercase tracking-widest text-amber-400 font-extrabold bg-white/10 px-4 py-1.5 rounded-full inline-block">
        22 MAJOR ARCANA ENCYCLOPEDIA
      </span>
      <h1 class="text-4xl sm:text-6xl font-serif font-bold text-amber-200">
        Arcana {arcanaData.number}: {arcanaData.name}
      </h1>
      <p class="text-purple-200 max-w-xl mx-auto text-base sm:text-lg">
        {arcanaData.archetype}
      </p>
    </div>
  </section>

  <!-- Main Content Body (2500+ Word Authority Guide) -->
  <div class="bg-stone-50 py-12 px-4">
    <div class="max-w-4xl mx-auto space-y-10">
      
      <!-- Meaning & Overview -->
      <div class="bg-white rounded-3xl p-8 border border-stone-200 shadow-sm space-y-4">
        <h2 class="text-2xl font-serif text-teal-950 font-bold border-b border-stone-100 pb-3">
          1. Core Meaning & Archetypal Frequency
        </h2>
        <p class="text-sm text-stone-700 leading-relaxed font-normal">
          {arcanaData.meaning}
        </p>
      </div>

      <!-- Positive & Shadow Expressions -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="bg-emerald-50/60 rounded-3xl p-6 border border-emerald-200 space-y-3">
          <h3 class="text-lg font-bold text-emerald-950">🌟 Positive High Frequency</h3>
          <p class="text-xs text-emerald-900 leading-relaxed">{arcanaData.positiveExpression}</p>
        </div>

        <div class="bg-rose-50/60 rounded-3xl p-6 border border-rose-200 space-y-3">
          <h3 class="text-lg font-bold text-rose-950">🌱 Shadow & Blocked Frequency</h3>
          <p class="text-xs text-rose-900 leading-relaxed">{arcanaData.shadowExpression}</p>
        </div>
      </div>

      <!-- Career, Love & Money Channels -->
      <div class="bg-white rounded-3xl p-8 border border-stone-200 shadow-sm space-y-6">
        <h2 class="text-2xl font-serif text-teal-950 font-bold border-b border-stone-100 pb-3">
          2. Vocation, Financial Flow & Love Resonance
        </h2>
        
        <div class="space-y-4">
          <div>
            <h4 class="text-sm font-bold text-teal-950">💼 Ideal Career Path</h4>
            <p class="text-xs text-stone-600 pt-1">{arcanaData.careerGuidance}</p>
          </div>

          <div>
            <h4 class="text-sm font-bold text-teal-950">💰 Money Channel Activation</h4>
            <p class="text-xs text-stone-600 pt-1">{arcanaData.moneyChannel}</p>
          </div>

          <div>
            <h4 class="text-sm font-bold text-teal-950">❤️ Love & Partnership Compatibility</h4>
            <p class="text-xs text-stone-600 pt-1">{arcanaData.loveCompatibility}</p>
          </div>
        </div>
      </div>

      <!-- Spiritual Lesson & Daily Guidance -->
      <div class="bg-gradient-to-r from-purple-900 to-slate-900 text-white rounded-3xl p-8 space-y-4 shadow-lg">
        <h3 class="text-xl font-serif font-bold text-amber-200">Spiritual Vocation & Daily Guidance</h3>
        <p class="text-xs text-purple-100 leading-relaxed font-medium">
          <strong>Spiritual Lesson:</strong> {arcanaData.spiritualLesson}
        </p>
        <p class="text-xs text-amber-300 leading-relaxed font-medium">
          <strong>Daily Wisdom:</strong> {arcanaData.dailyWisdom}
        </p>
      </div>

      <!-- All 22 Arcana Navigation Cluster -->
      <div class="pt-6 space-y-4">
        <h3 class="text-xl font-serif text-teal-950 font-bold text-center">
          Explore All 22 Major Arcana Encyclopedias
        </h3>
        <div class="flex flex-wrap justify-center gap-2">
          {Array.from({ length: 22 }, (_, index) => index + 1).map((num) => (
            <a
              href={`/${locale}/destiny-matrix/arcana/${num}-${(MAJOR_ARCANA_DATABASE[num]?.name || 'Arcana').toLowerCase().replace(/\s+/g, '-')}/`}
              class={`px-4 py-2 rounded-xl text-xs font-bold transition-all ${num === arcanaNum ? 'bg-purple-600 text-white shadow-md' : 'bg-white text-stone-700 border border-stone-200 hover:border-purple-400'}`}
            >
              Arcana {num}
            </a>
          ))}
        </div>
      </div>

    </div>
  </div>
</BaseLayout>
