---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/common/Breadcrumbs.astro';
import DisclaimerBox from '../../../../components/common/DisclaimerBox.astro';
import MethodologyBox from '../../../../components/common/MethodologyBox.astro';
import { MAJOR_ARCANA_DATABASE, getLocalizedArcanaEntry } from '../../../../data/arcana';
import { supportedLocales } from '../../../../config/locales.config';
import { t } from '../../../../i18n';

export function getStaticPaths() {
  const paths = [];

  for (const locale of supportedLocales) {
    for (let i = 1; i <= 22; i++) {
      const entry = MAJOR_ARCANA_DATABASE[i] || MAJOR_ARCANA_DATABASE[1];
      const slugName = entry.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      paths.push({
        params: {
          locale,
          arcanaSlug: `${i}-${slugName}`
        }
      });
    }
  }
  return paths;
}

const { locale = 'en', arcanaSlug } = Astro.params;
const currentLocale = locale;

const arcanaNum = parseInt((arcanaSlug || '1').split('-')[0], 10) || 1;
const arcanaData = getLocalizedArcanaEntry(arcanaNum, currentLocale);

const pageTitle = `Arcana ${arcanaData.number}: ${arcanaData.name} Guide`;
const pageDesc = `Explore Arcana ${arcanaData.number} (${arcanaData.name}) in the Destiny Matrix system. Detailed analysis of positive and shadow expressions, career vocation, love line, money channel, and practical self-reflection questions.`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: pageTitle,
  description: pageDesc,
  author: { '@type': 'Organization', name: 'Souliography Editorial Team' },
  publisher: { '@type': 'Organization', name: 'Souliography', url: `https://souliography.com/${currentLocale}/` },
  mainEntityOfPage: `https://souliography.com/${currentLocale}/destiny-matrix/arcana/${arcanaSlug}/`
};

const breadcrumbItems = [
  { label: t('nav.home', currentLocale), href: `/${currentLocale}/` },
  { label: 'Arcana Directory', href: `/${currentLocale}/destiny-matrix/arcana/` },
  { label: `Arcana ${arcanaData.number}: ${arcanaData.name}` }
];

const guideKey = `arcana.${arcanaNum}.guideHtml`;
const rawGuideHtml = t(guideKey, currentLocale);
const hasGuide = rawGuideHtml && rawGuideHtml !== guideKey;

const cardImageSlug = `${arcanaData.number}-${arcanaData.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}`;
const cardJpgPath = `/images/arcana/${cardImageSlug}.jpg`;
---

<BaseLayout title={pageTitle} description={pageDesc} locale={currentLocale}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <!-- Hero Header Panel with Tarot Card Illustration -->
  <section class="bg-[#231530] text-white py-12 px-4 border-b-2 border-[#C4A052]">
    <div class="max-w-4xl mx-auto space-y-4">
      <Breadcrumbs items={breadcrumbItems} locale={currentLocale} />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center pt-2">
        <div class="md:col-span-2 space-y-4">
          <span class="text-xs uppercase tracking-widest text-[#C4A052] font-mono font-bold bg-white/10 px-3 py-1 rounded inline-block border border-[#C4A052]/40">
            22 Major Arcana Reference Library
          </span>
          <h1 class="text-4xl sm:text-5xl font-serif font-bold text-amber-100">
            Arcana {arcanaData.number}: {arcanaData.name}
          </h1>
          <p class="text-purple-200 max-w-2xl text-base sm:text-lg font-serif">
            {arcanaData.archetype}
          </p>
          <div class="flex flex-wrap gap-2.5 pt-2 text-xs font-mono text-[#C4A052]">
            <span class="bg-black/40 px-3 py-1 rounded border border-[#C4A052]/30">Chakra: {arcanaData.chakraConnection}</span>
          </div>
        </div>

        <div class="flex justify-center md:justify-end">
          <div class="relative group">
            <div class="absolute -inset-1 bg-gradient-to-r from-[#C4A052] to-[#9E7B3B] rounded-lg blur opacity-40 group-hover:opacity-75 transition duration-300"></div>
            <img 
              src={cardJpgPath} 
              alt={`Tarot Card Illustration of Arcana ${arcanaData.number}: ${arcanaData.name}`} 
              class="relative w-44 sm:w-52 rounded-lg border-2 border-[#C4A052] shadow-2xl object-cover aspect-[3/4]"
              onerror="this.onerror=null; this.src=this.src.replace('.jpg', '.svg');"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Reference Guide Content Body -->
  <div class="bg-[#FBF9F5] py-10 px-4 text-[#1C1625]">
    <div class="max-w-4xl mx-auto space-y-8">

      <!-- 1. Core Meaning & Archetypal Vibration -->
      <article class="ref-card p-6 sm:p-8 space-y-4">
        <h2 class="text-2xl font-serif font-bold text-[#1C1625] border-b border-[#D8D0C5] pb-3 flex items-center gap-2">
          <span>📜</span>
          <span>1. Core Archetypal Meaning</span>
        </h2>
        <p class="text-sm leading-relaxed text-[#1C1625]">
          {arcanaData.meaning}
        </p>
        <div class="p-4 bg-[#F5F2EB] rounded border border-[#D8D0C5] space-y-1 pt-3">
          <h3 class="text-xs font-mono font-bold uppercase text-[#9E7B3B] tracking-wider">Historical & Esoteric Context</h3>
          <p class="text-xs text-[#524B5A] leading-relaxed">{arcanaData.historicalContext}</p>
        </div>
      </article>

      <!-- 2. Constructive High Frequency vs Shadow Expressions Table -->
      <article class="ref-card p-6 sm:p-8 space-y-4">
        <h2 class="text-2xl font-serif font-bold text-[#1C1625] border-b border-[#D8D0C5] pb-3 flex items-center gap-2">
          <span>⚖️</span>
          <span>2. Constructive High Frequency (+{arcanaData.number}) vs. Shadow Challenges (-{arcanaData.number})</span>
        </h2>
        <div class="overflow-x-auto">
          <table class="w-full text-xs text-left border-collapse border border-[#D8D0C5]">
            <thead class="bg-[#F5F2EB] text-[#231530] font-serif font-bold">
              <tr>
                <th class="p-3 border border-[#D8D0C5]">Vibrational State</th>
                <th class="p-3 border border-[#D8D0C5]">Key Behaviors & Manifestations</th>
                <th class="p-3 border border-[#D8D0C5]">Harmonization & Remediation Strategy</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#D8D0C5] text-[#1C1625]">
              <tr class="bg-emerald-50/40">
                <td class="p-3 border font-bold text-emerald-900">High Frequency (+{arcanaData.number})</td>
                <td class="p-3 border">{arcanaData.positiveExpression}</td>
                <td class="p-3 border">Align daily goals with ethical integrity, channel vital potential into constructive projects, and cultivate calm confidence.</td>
              </tr>
              <tr class="bg-rose-50/40">
                <td class="p-3 border font-bold text-rose-900">Shadow Frequency (-{arcanaData.number})</td>
                <td class="p-3 border">{arcanaData.shadowExpression}</td>
                <td class="p-3 border">Acknowledge shadow triggers without self-judgment, establish clear personal boundaries, and avoid coercive or fear-driven control.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </article>

      <!-- 3. Vocation, Money Line & Love Synergy -->
      <article class="ref-card p-6 sm:p-8 space-y-6">
        <h2 class="text-2xl font-serif font-bold text-[#1C1625] border-b border-[#D8D0C5] pb-3 flex items-center gap-2">
          <span>💼</span>
          <span>3. Vocation, Money Line & Love Synergy</span>
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-1">
          <div class="p-4 bg-[#F5F2EB] rounded border border-[#D8D0C5] space-y-1">
            <h4 class="text-xs font-bold text-[#231530] font-serif">Ideal Career Vocation</h4>
            <p class="text-xs text-[#524B5A] leading-relaxed">{arcanaData.careerGuidance}</p>
          </div>

          <div class="p-4 bg-[#F5F2EB] rounded border border-[#D8D0C5] space-y-1">
            <h4 class="text-xs font-bold text-[#231530] font-serif">Money Channel Activation</h4>
            <p class="text-xs text-[#524B5A] leading-relaxed">{arcanaData.moneyChannel}</p>
          </div>

          <div class="p-4 bg-[#F5F2EB] rounded border border-[#D8D0C5] space-y-1">
            <h4 class="text-xs font-bold text-[#231530] font-serif">Love & Partnership Synergy</h4>
            <p class="text-xs text-[#524B5A] leading-relaxed">{arcanaData.loveCompatibility}</p>
          </div>
        </div>
      </article>

      <!-- 4. Practical Self-Reflection Prompts -->
      <article class="p-6 sm:p-8 space-y-4 bg-[#231530] text-white border-2 border-[#C4A052] rounded-lg shadow-md">
        <h3 class="text-xl font-serif font-bold text-[#F3E5AB] flex items-center gap-2">
          <span>🔮</span>
          <span>Practical Self-Reflection Prompts</span>
        </h3>
        <p class="text-xs sm:text-sm text-purple-100 font-medium">
          Use these reflection questions to examine how Arcana {arcanaData.number} manifests in your choices:
        </p>
        <ul class="space-y-2.5 pt-1">
          {arcanaData.reflectionQuestions.map((q) => (
            <li class="text-xs sm:text-sm text-purple-100 flex items-start gap-2.5 leading-relaxed">
              <span class="text-[#C4A052] font-bold select-none text-base">›</span>
              <span>{q}</span>
            </li>
          ))}
        </ul>
        <p class="text-xs text-[#C4A052] italic pt-1">
          Daily Wisdom: "{arcanaData.dailyWisdom}"
        </p>
      </article>

      <!-- 5. Extended Comprehensive Guide Article (if present) -->
      {hasGuide && (
        <div class="pt-4">
          <Fragment set:html={rawGuideHtml} />
        </div>
      )}

      <!-- Standard Methodology & Disclaimer Components -->
      <div class="pt-6 space-y-6">
        <MethodologyBox locale={currentLocale} />
        <DisclaimerBox locale={currentLocale} />
      </div>

    </div>
  </div>
</BaseLayout>
