---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/ui/Icon.astro';
import { numerologyCalculators, type CalculatorConfig } from '../../../config/calculators.config';
import { supportedLocales } from '../../../config/locales.config';

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const { locale = 'en' } = Astro.params;

const pageTitle = `Numerology Calculators Directory & Meanings | Souliography`;
const pageDesc = `Explore the complete 26 Numerology Calculators directory. Discover deep archetype analysis for Life Path, Destiny, Soul Urge, Personality, Karmic Debt, and Vocation numbers.`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `https://souliography.com/${locale}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Numerology',
      item: `https://souliography.com/${locale}/numerology/`,
    },
  ],
};
---

<BaseLayout title={pageTitle} description={pageDesc} locale={locale}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Hero Header -->
  <section class="bg-gradient-to-b from-violet-950 via-purple-900 to-slate-900 text-white py-16 px-4 text-center">
    <div class="max-w-4xl mx-auto space-y-4">
      
      <!-- HTML Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-4">
        <ol class="inline-flex items-center gap-2 text-xs text-purple-300 font-mono">
          <li>
            <a href={`/${locale}/`} class="hover:text-amber-300 transition-colors">Home</a>
          </li>
          <li>/</li>
          <li class="text-amber-200 font-bold" aria-current="page">Numerology</li>
        </ol>
      </nav>

      <span class="text-xs uppercase tracking-widest text-amber-400 font-extrabold bg-white/10 px-4 py-1.5 rounded-full inline-block">
        NUMEROLOGY DIRECTORY & KNOWLEDGE HUB
      </span>
      <h1 class="text-4xl sm:text-6xl font-black font-heading bg-gradient-to-r from-amber-200 via-pink-200 to-white bg-clip-text text-transparent">
        26 Numerology Calculators & Vibrations
      </h1>
      <p class="text-purple-200 max-w-2xl mx-auto text-base sm:text-lg">
        Select any numerology core calculator below to explore detailed meanings for Master Numbers 1–9, 11, 22, and 33.
      </p>
    </div>
  </section>

  <!-- Directory Grid -->
  <div class="bg-gradient-to-b from-purple-50 via-pink-50/50 to-amber-50/30 py-12 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {numerologyCalculators.map((calc: CalculatorConfig) => {
          const formattedName = calc.id.replace(/-/g, ' ').replace(/\b\w/g, (l) => l.toUpperCase());
          return (
            <div class="bg-white rounded-2xl p-6 border border-purple-200 shadow-sm hover:shadow-md transition-all space-y-4 flex flex-col justify-between">
              <div class="space-y-3">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-purple-100 flex items-center justify-center text-purple-900 text-lg">
                    <Icon symbol={calc.icon || '🔮'} size="sm" />
                  </div>
                  <h2 class="text-lg font-bold text-purple-950 font-heading">
                    {formattedName}
                  </h2>
                </div>
                <p class="text-xs text-stone-600 leading-relaxed">
                  Explore full vibrational meanings, career alignment, relationships, and spiritual archetype analysis for {formattedName}.
                </p>
              </div>

              <div class="pt-2 flex items-center justify-between border-t border-purple-100">
                <a
                  href={`/${locale}/numerology/${calc.slug}/`}
                  class="text-xs font-bold text-purple-700 hover:text-purple-900 hover:underline inline-flex items-center gap-1 font-mono"
                >
                  View All Number Meanings →
                </a>
                <a
                  href={`/${locale}/calculators/${calc.slug}/`}
                  class="text-xs font-bold text-amber-600 hover:text-amber-800 hover:underline inline-flex items-center gap-1 font-mono"
                >
                  Run Calculator ⚡
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</BaseLayout>
