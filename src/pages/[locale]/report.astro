---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DestinyMatrixChart from '../../components/matrix/DestinyMatrixChart.astro';
import { generateOrGetDeepReport } from '../../services/calculation/report-generator';
import { supportedLocales } from '../../config/locales.config';
import { t } from '../../i18n';

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const { locale = 'en' } = Astro.params;
const nameParam = Astro.url.searchParams.get('name') || '';
const dobParam = Astro.url.searchParams.get('dob') || '1980-01-14';

const defaultReport = await generateOrGetDeepReport(dobParam, nameParam);
const hasQueryParams = Boolean(Astro.url.searchParams.get('name') || Astro.url.searchParams.get('dob'));

---

<BaseLayout title={`Soul Matrix Deep Report | Souliography`} description="Read your complete 10-section Soul Matrix Deep Report." locale={locale} noIndex={hasQueryParams}>
  <!-- Clean Printable PDF Stylesheet with Anchor Smooth Scrolling -->
  <style is:global>
    html {
      scroll-behavior: smooth;
    }
    @media print {
      * {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
      @page {
        size: A4 portrait;
        margin: 0;
      }
      @page :first {
        margin: 0;
      }
      body {
        background: #ffffff !important;
        color: #1c1c1c !important;
        font-family: serif !important;
      }
      header, nav, footer, .no-print {
        display: none !important;
      }
      .page-break {
        page-break-before: always !important;
        break-before: page !important;
      }
      .print-card {
        border: none !important;
        box-shadow: none !important;
        padding: 0 !important;
        margin: 0 !important;
      }
      /* Cover page fills exactly one A4 page */
      .pdf-cover {
        width: 210mm;
        height: 297mm !important;
        min-height: 297mm !important;
        max-height: 297mm !important;
        margin: 0 !important;
        padding: 0 !important;
        border-radius: 0 !important;
        background-color: #0d0118 !important;
        color: #f5f0e8 !important;
        page-break-after: always !important;
        break-after: page !important;
        overflow: hidden !important;
        display: flex !important;
        flex-direction: column !important;
      }
      .pdf-cover h1 {
        color: #f5f0e8 !important;
      }
      .pdf-cover p {
        color: rgba(245, 240, 232, 0.75) !important;
      }
      .pdf-cover strong, .pdf-cover span {
        color: #e8c88c !important;
      }
      .pdf-cover span#coverName {
        color: #f5a0b0 !important;
      }
      /* Hexagram page fills full A4 */
      .pdf-chart-page {
        width: 210mm;
        min-height: 297mm;
        margin: 0;
        border-radius: 0 !important;
      }
    }
    /* Social share button base style */
    .share-social-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: 9999px;
      font-size: 11px;
      font-weight: 700;
      color: white;
      cursor: pointer;
      border: none;
      outline: none;
      transition: opacity 0.15s, transform 0.12s;
      white-space: nowrap;
    }
    .share-social-btn:hover {
      opacity: 0.88;
      transform: translateY(-1px);
    }
    .share-social-btn:active {
      transform: scale(0.97);
    }
  </style>

  <div class="bg-[#F7F3EC] min-h-screen py-10 px-4 font-sans text-stone-800">
    <div class="max-w-4xl mx-auto space-y-8">
      
      <!-- Top Action Bar -->
      <div class="no-print flex flex-wrap gap-3 justify-between items-center bg-white rounded-2xl p-4 border border-stone-200 shadow-2xs">
        <a href={`/${locale}/`} class="text-xs font-bold text-[#2E4A3D] hover:underline flex items-center gap-1">
          ← {locale === 'ar' ? 'العودة إلى حاسبة مصفوفة الروح' : (locale === 'pt' ? 'Voltar para Calculadora da Matriz da Alma' : 'Back to Soul Matrix Calculator')}
        </a>
        <!-- Social Share Bar -->
        <div class="flex items-center gap-2 flex-wrap">
          <!-- Facebook -->
          <button id="shareFacebook" title="Share on Facebook" class="share-social-btn" style="background:#1877F2;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="white"><path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.97h-1.513c-1.491 0-1.956.93-1.956 1.874v2.25h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/></svg>
            <span>Facebook</span>
          </button>
          <!-- X (Twitter) -->
          <button id="shareX" title="Share on X" class="share-social-btn" style="background:#000000;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="white"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.741l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            <span>X</span>
          </button>
          <!-- Instagram -->
          <button id="shareInstagram" title="Share on Instagram" class="share-social-btn" style="background:linear-gradient(45deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888);">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="white"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            <span>Instagram</span>
          </button>
          <!-- TikTok -->
          <button id="shareTikTok" title="Share on TikTok" class="share-social-btn" style="background:#010101;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="white"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.32 6.32 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.75a8.18 8.18 0 004.78 1.52V6.82a4.85 4.85 0 01-1.01-.13z"/></svg>
            <span>TikTok</span>
          </button>
          <!-- Snapchat -->
          <button id="shareSnapchat" title="Share on Snapchat" class="share-social-btn" style="background:#FFFC00; color:#000;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="black"><path d="M12.065.026C9.09.026 6.21 1.67 4.754 4.17c-.74 1.27-.948 2.69-.948 4.12 0 .36.022.72.044 1.07-.31.16-.65.24-1.01.24-.33 0-.67-.07-.97-.21-.12-.06-.25-.09-.38-.09-.34 0-.63.19-.72.5-.06.2-.04.42.06.6.24.46.96.83 2.04 1.05.05.01.1.02.15.04-.15.43-.41.83-.76 1.13-.74.64-1.56.93-1.56 1.42 0 .38.31.72.82.72.17 0 .35-.04.52-.1.54-.2 1.06-.3 1.56-.3.59 0 1.07.13 1.48.39.83.52 1.41 1.53 2.52 2.36.93.69 2.04 1.06 3.16 1.06.33 0 .66-.04.98-.12.19.08.39.16.62.23.73.22 1.52.35 2.34.35.77 0 1.51-.12 2.21-.32.24-.07.45-.16.63-.25.32.08.65.12.98.12 1.12 0 2.23-.37 3.16-1.06 1.11-.83 1.69-1.84 2.52-2.36.41-.26.89-.39 1.48-.39.5 0 1.02.1 1.56.3.17.06.35.1.52.1.51 0 .82-.34.82-.72 0-.49-.82-.78-1.56-1.42-.35-.3-.61-.7-.76-1.13.05-.02.1-.03.15-.04 1.08-.22 1.8-.59 2.04-1.05.1-.18.12-.4.06-.6-.09-.31-.38-.5-.72-.5-.13 0-.26.03-.38.09-.3.14-.64.21-.97.21-.36 0-.7-.08-1.01-.24.022-.35.044-.71.044-1.07 0-1.43-.208-2.85-.948-4.12C17.79 1.67 14.91.026 12.065.026z"/></svg>
            <span>Snapchat</span>
          </button>
          <!-- WhatsApp -->
          <button id="shareWhatsApp" title="Share on WhatsApp" class="share-social-btn" style="background:#25D366;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            <span>WhatsApp</span>
          </button>
          <!-- Email -->
          <button id="shareEmail" title="Share via Email" class="share-social-btn" style="background:#6B7280;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="white"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
            <span>Email</span>
          </button>
          <!-- Copy Link -->
          <button id="shareCopyLink" title="Copy Link" class="share-social-btn" style="background:#8B5CF6;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="white"><path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/></svg>
            <span id="copyLinkLabel">{locale === 'ar' ? 'نسخ الرابط' : (locale === 'pt' ? 'Copiar Link' : 'Copy Link')}</span>
          </button>
          <!-- Download PDF -->
          <button onclick="window.print()" class="share-social-btn" style="background:#2E4A3D;">
            <span>📄</span>
            <span>{locale === 'ar' ? 'PDF' : (locale === 'pt' ? 'PDF' : 'PDF')}</span>
          </button>
        </div>
      </div>

      <!-- ══════════════════════════════════════════════════ -->
      <!-- COVER PAGE — Branded Hero Image + Name/DOB overlay -->
      <!-- ══════════════════════════════════════════════════ -->
      <div class="pdf-cover bg-[#0d0118] rounded-3xl overflow-hidden relative flex flex-col print-card" style="min-height:600px;">

        <!-- Full-bleed hero image -->
        <img
          src="/contact_hero_combined.jpg"
          alt="Souliography Soul Matrix Report Cover"
          class="absolute inset-0 w-full h-full object-cover object-center opacity-70"
          style="object-position: center 20%;"
        />

        <!-- Dark gradient overlay for readability -->
        <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(10,3,24,0.35) 0%, rgba(10,3,24,0.55) 40%, rgba(10,3,24,0.92) 75%, #0d0118 100%);"></div>

        <!-- Content -->
        <div class="relative z-10 flex flex-col justify-end flex-1 p-10 sm:p-16 space-y-6 text-center">

          <!-- Souliography Logo Wordmark -->
          <div class="absolute top-8 left-0 right-0 flex justify-center">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-[#6A3289] to-[#2E4A3D] flex items-center justify-center text-lg shadow-lg border border-amber-300/30">✨</div>
              <span class="text-amber-100 font-serif font-bold text-2xl tracking-wide" style="text-shadow:0 2px 12px rgba(0,0,0,0.7);">Souliography</span>
            </div>
          </div>

          <!-- Report title + seeker name -->
          <div class="space-y-3 pt-8">
            <span id="coverTag" class="text-[11px] font-bold uppercase tracking-widest block" style="color:#d4a0a0;">Personalized Soul Matrix Reading</span>
            <h1 id="coverTitle" class="font-serif font-bold leading-tight" style="font-size:clamp(2rem,5vw,3.2rem); color:#f5f0e8; text-shadow:0 2px 20px rgba(0,0,0,0.6);">
              {defaultReport.titleName} Soul Matrix
            </h1>
            <p class="font-serif text-lg" style="color:rgba(245,240,232,0.7);">Deep Personal Interpretation</p>
          </div>

          <!-- Personalized metadata badge -->
          <div class="mx-auto rounded-2xl px-8 py-5 space-y-2 text-sm" style="background:rgba(255,255,255,0.07); border:1px solid rgba(196,164,122,0.3); backdrop-filter:blur(8px); max-width:400px;">
            <p style="color:#e8c88c; font-weight:700;">Prepared for: <span id="coverName" style="color:#f5a0b0;">{defaultReport.name || 'Seeker'}</span></p>
            <p style="color:rgba(245,240,232,0.75);"><strong style="color:#e8c88c;">Date of Birth:</strong> <span id="coverDob">January 14, 1980</span></p>
            <p style="color:rgba(245,240,232,0.65);"><strong style="color:#e8c88c;">Generated:</strong> {defaultReport.generatedDate}</p>
            <p style="color:rgba(245,240,232,0.65);"><strong style="color:#e8c88c;">{locale === 'ar' ? 'مدة القراءة:' : (locale === 'pt' ? 'Tempo de Leitura:' : 'Reading Time:')}</strong> {locale === 'ar' ? '١٢ دقيقة قراءة' : (locale === 'pt' ? '12 min de leitura' : '12 min read')}</p>
          </div>

          <!-- Footer brand line -->
          <div class="flex justify-between text-[11px] font-mono pt-4" style="color:rgba(245,240,232,0.4);">
            <span>souliography.com</span>
            <span>Page 1 · Soul Matrix Deep Report</span>
          </div>

        </div>
      </div>

      <!-- ══════════════════════════════════════════════════ -->
      <!-- PAGE 2 — Personal Destiny Matrix Hexagram Chart    -->
      <!-- ══════════════════════════════════════════════════ -->
      <div class="pdf-chart-page page-break bg-white rounded-3xl p-8 sm:p-12 border border-stone-200/80 shadow-md print-card">
        <!-- Header -->
        <div class="text-center space-y-2 border-b border-stone-100 pb-6 mb-6">
          <div class="flex items-center justify-center gap-2">
            <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-[#2E163B] to-[#2E4A3D] flex items-center justify-center text-sm">✨</div>
            <span class="text-[10px] font-bold text-[#B67B7B] uppercase tracking-widest font-mono">Destiny Matrix Chart</span>
          </div>
          <h2 id="chartPageTitle" class="text-2xl sm:text-3xl font-serif text-[#2E3D34] font-bold">
            {defaultReport.titleName} Personal Hexagram
          </h2>
          <p class="text-xs text-stone-500 font-medium" id="chartPageSubtitle">Birth date energy map — all positions calculated from your date of birth</p>
        </div>

        <!-- The Destiny Matrix Hexagram — dynamically sized for print -->
        <div class="flex justify-center">
          <div class="w-full max-w-[520px]" id="chartContainer">
            <DestinyMatrixChart
              dayArcana={14}
              monthArcana={1}
              yearArcana={6}
              bottomArcana={21}
              centerArcana={6}
            />
          </div>
        </div>

        <!-- Matrix key legend -->
        <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-3" id="chartLegend">
          <div class="text-center p-3 bg-[#F7F3EC] rounded-xl">
            <div class="text-[10px] text-stone-500 uppercase tracking-widest font-mono">{locale === 'ar' ? 'المركز' : (locale === 'pt' ? 'Centro' : 'Center')}</div>
            <div class="text-xl font-serif font-bold text-[#2E3D34] mt-1" id="legendCenter">6</div>
            <div class="text-[10px] text-[#B67B7B]">{locale === 'ar' ? 'مسار الحياة' : (locale === 'pt' ? 'Caminho de Vida' : 'Life Purpose')}</div>
          </div>
          <div class="text-center p-3 bg-[#F7F3EC] rounded-xl">
            <div class="text-[10px] text-stone-500 uppercase tracking-widest font-mono">{locale === 'ar' ? 'الروح' : (locale === 'pt' ? 'Alma' : 'Soul')}</div>
            <div class="text-xl font-serif font-bold text-[#2E3D34] mt-1" id="legendSoul">—</div>
            <div class="text-[10px] text-[#B67B7B]">{locale === 'ar' ? 'الطبيعة الداخلية' : (locale === 'pt' ? 'Natureza Interna' : 'Inner Nature')}</div>
          </div>
          <div class="text-center p-3 bg-[#F7F3EC] rounded-xl">
            <div class="text-[10px] text-stone-500 uppercase tracking-widest font-mono">{locale === 'ar' ? 'الكارما' : (locale === 'pt' ? 'Karma' : 'Karma')}</div>
            <div class="text-xl font-serif font-bold text-[#2E3D34] mt-1" id="legendKarma">21</div>
            <div class="text-[10px] text-[#B67B7B]">{locale === 'ar' ? 'الذيل الكارمي' : (locale === 'pt' ? 'Cauda Kármica' : 'Karmic Tail')}</div>
          </div>
          <div class="text-center p-3 bg-[#F7F3EC] rounded-xl">
            <div class="text-[10px] text-stone-500 uppercase tracking-widest font-mono">DOB</div>
            <div class="text-xl font-serif font-bold text-[#2E3D34] mt-1" id="legendDob">14·1·6</div>
            <div class="text-[10px] text-[#B67B7B]">{locale === 'ar' ? 'اليوم · الشهر · السنة' : (locale === 'pt' ? 'Dia · Mês · Ano' : 'Day · Month · Year')}</div>
          </div>
        </div>

        <div class="pt-6 border-t border-stone-100 flex justify-between text-[11px] text-stone-400 font-mono mt-6">
          <span>souliography.com</span>
          <span>{locale === 'ar' ? 'الصفحة ٢ · الشكل السداسي الشخصي' : (locale === 'pt' ? 'Página 2 · Hexagrama Pessoal' : 'Page 2 · Personal Hexagram')}</span>
        </div>
      </div>

      <!-- TABLE OF CONTENTS (Page 2 - With Clickable Anchor Links!) -->
      <div class="page-break bg-white rounded-3xl p-8 sm:p-12 border border-stone-200/80 shadow-md space-y-6 print-card">
        <div class="border-b border-stone-100 pb-4 flex justify-between items-center">
          <div>
            <span class="text-[10px] font-bold text-[#B67B7B] uppercase tracking-widest block font-mono">{locale === 'ar' ? 'فهرس التقرير' : (locale === 'pt' ? 'ÍNDICE DO RELATÓRIO' : 'REPORT INDEX')}</span>
            <h2 class="text-2xl font-serif text-[#2E3D34] font-bold">{locale === 'ar' ? 'جدول المحتويات' : (locale === 'pt' ? 'Índice de Conteúdo' : 'Table of Contents')}</h2>
          </div>
          <span class="text-xs text-stone-400 font-medium">{locale === 'ar' ? 'انقر على أي قسم للانتقال إليه مباشرة' : (locale === 'pt' ? 'Clique em qualquer seção para ir direto' : 'Click any section to jump directly')}</span>
        </div>

        <!-- Clickable TOC Links with Hover Highlighting -->
        <div class="space-y-3 text-xs sm:text-sm font-medium text-stone-700 font-mono">
          <a href="#core-personality" class="flex justify-between border-b border-dashed border-stone-200 pb-2.5 hover:text-[#2E4A3D] hover:border-[#7A9B7E] transition-colors group">
            <span class="group-hover:translate-x-1 transition-transform">{locale === 'ar' ? '١. خريطة الشخصية الأساسية' : (locale === 'pt' ? '1. Mapa de Personalidade Principal' : '1. Core Personality Map')}</span>
            <span class="text-stone-400 group-hover:text-[#2E4A3D] font-bold">Page 3 →</span>
          </a>

          <a href="#life-purpose" class="flex justify-between border-b border-dashed border-stone-200 pb-2.5 hover:text-[#2E4A3D] hover:border-[#7A9B7E] transition-colors group">
            <span class="group-hover:translate-x-1 transition-transform">{locale === 'ar' ? '٢. مسار الحياة ورسالة الروح' : (locale === 'pt' ? '2. Propósito de Vida e Missão da Alma' : '2. Life Purpose & Soul Mission')}</span>
            <span class="text-stone-400 group-hover:text-[#2E4A3D] font-bold">Page 4 →</span>
          </a>

          <a href="#career-money" class="flex justify-between border-b border-dashed border-stone-200 pb-2.5 hover:text-[#2E4A3D] hover:border-[#7A9B7E] transition-colors group">
