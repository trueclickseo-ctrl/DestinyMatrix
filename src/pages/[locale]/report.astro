          b: `Positioned at Arcana ${talentArc}, your innate superpower centers on ${getArc(talentArc).gift}. For ${displayName}, this intuitive strength operates with natural ease, providing a distinct strategic advantage.`,
          n: `Talent Arcana ${talentArc}`
        };
        secs['chakra-analysis'] = {
          h: `Crown Physics ${reduceArcana(dayArc + monthArc)} and Heart Emotion ${reduceArcana(centerArc + monthArc)} balance mental & emotional focus.`,
          b: `Your personalized energy chart bridges upper mental clarity (Crown ${reduceArcana(dayArc + monthArc)}) with emotional resonance (Heart ${reduceArcana(centerArc + monthArc)}). Root energy anchors physical stamina, giving ${displayName} balanced endurance across daily demands.`,
          n: `Crown ${reduceArcana(dayArc + monthArc)}, Heart ${reduceArcana(centerArc + monthArc)}`
        };
        secs['current-life-stage'] = {
          h: `Your timing cycle activates Year Arcana ${yearArc} (${getArc(yearArc).title}), urging decisive action through ${getArc(yearArc).core}.`,
          b: `Reflecting your active age cycle, Year Arcana ${yearArc} emphasizes ${getArc(yearArc).gift}. For ${displayName}, this period rewards clear initiative over passive hesitation.`,
          n: `Current Year Arcana ${yearArc}`
        };
        secs['growth-roadmap'] = {
          h: `Focus 30-day goals on Life Path ${lifePathNum} (${getArc(lifePathNum).title}) while releasing Karmic ${bottomArc} hesitation.`,
          b: `Your growth roadmap calls ${displayName} to double down on ${getArc(lifePathNum).gift}. Simultaneously, releasing ${getArc(bottomArc).challenge} unlocks immediate momentum across personal and professional domains.`,
          n: `Life Path Arcana ${lifePathNum}, Karmic Arcana ${bottomArc}`
        };
        secs['soul-summary'] = {
          h: `Synthesis for ${displayName}: Unifying Center ${centerArc}, Life Path ${lifePathNum}, and Love Line ${loveArc} into active mastery.`,
          b: `Your Soul Matrix connects identity (${centerArc}: ${getArc(centerArc).title}), purpose (${lifePathNum}: ${getArc(lifePathNum).title}), and relationships (${loveArc}: ${getArc(loveArc).title}). Aligning these arcana provides ${displayName} with an authentic, empowering framework for lifelong fulfillment.`,
          n: `Center ${centerArc}, Life Path ${lifePathNum}, Money ${moneyArc}, Love ${loveArc}`
        };
      }

      for (const [k, v] of Object.entries(secs)) {
        const hEl = document.getElementById(`sec-head-${k}`);
        if (hEl) hEl.textContent = v.h;
        const bEl = document.getElementById(`sec-body-${k}`);
        if (bEl) bEl.textContent = v.b;
        const nEl = document.getElementById(`sec-nums-${k}`);
        if (nEl) {
          const lbl = currentLocale === 'ar' ? 'الأرقام ذات الصلة' : (currentLocale === 'pt' ? 'Números relevantes' : 'Relevant numbers');
          nEl.textContent = `${lbl}: ${v.n}`;
        }
      }

      // ── Social Share handlers ──────────────────────────────────────────
      const pageUrl = encodeURIComponent(window.location.href);
      const shareText = encodeURIComponent(
        currentLocale === 'ar'
          ? 'شاهد تقرير مصفوفة الروح الخاص بي على Souliography!'
          : currentLocale === 'pt'
          ? 'Veja meu Relatório da Matriz da Alma no Souliography!'
          : 'Check out my Destiny Matrix (Soul Matrix) Report on Souliography!'
      );

      const socialHandlers = {
        shareFacebook: () =>
          window.open(`https://www.facebook.com/sharer/sharer.php?u=${pageUrl}`, '_blank'),
        shareX: () =>
          window.open(`https://x.com/intent/tweet?url=${pageUrl}&text=${shareText}`, '_blank'),
        shareInstagram: async () => {
          await navigator.clipboard.writeText(window.location.href);
          alert(currentLocale === 'ar'
            ? 'تم نسخ الرابط! افتح إنستغرام لمشاركته.'
            : currentLocale === 'pt'
            ? 'Link copiado! Abra o Instagram para compartilhá-lo.'
            : 'Link copied! Open Instagram to share it.');
          window.open('https://instagram.com', '_blank');
        },
        shareTikTok: async () => {
          await navigator.clipboard.writeText(window.location.href);
          alert(currentLocale === 'ar'
            ? 'تم نسخ الرابط! افتح TikTok لمشاركته.'
            : currentLocale === 'pt'
            ? 'Link copiado! Abra o TikTok para compartilhá-lo.'
            : 'Link copied! Open TikTok to share it.');
          window.open('https://tiktok.com', '_blank');
        },
        shareSnapchat: () =>
          window.open(`https://www.snapchat.com/scan?attachmentUrl=${pageUrl}`, '_blank'),
        shareWhatsApp: () =>
          window.open(`https://api.whatsapp.com/send?text=${shareText}%20${pageUrl}`, '_blank'),
        shareEmail: () =>
          window.location.href = `mailto:?subject=${encodeURIComponent('My Soul Matrix Report — Souliography')}&body=${shareText}%20${pageUrl}`,
        shareCopyLink: async () => {
          try {
            await navigator.clipboard.writeText(window.location.href);
            const lbl = document.getElementById('copyLinkLabel');
            if (lbl) {
              lbl.textContent = currentLocale === 'ar' ? '✓ تم النسخ' : currentLocale === 'pt' ? '✓ Copiado' : '✓ Copied!';
              setTimeout(() => {
                lbl.textContent = currentLocale === 'ar' ? 'نسخ الرابط' : currentLocale === 'pt' ? 'Copiar Link' : 'Copy Link';
              }, 2000);
            }
          } catch (err) { console.error(err); }
        }
      };

      for (const [id, handler] of Object.entries(socialHandlers)) {
        const btn = document.getElementById(id);
        if (btn) btn.addEventListener('click', handler);
      }
    })();
  </script>
</BaseLayout>
