---
import { t } from '../../i18n';

interface Props {
  locale?: string;
  text?: string;
}

const { locale = 'en', text } = Astro.props;
const disclaimerText = text || t('disclaimer.text', locale);
---

<div class="p-4 rounded bg-[#FBF9F5] border border-[#D8D0C5] text-xs text-[#524B5A] leading-relaxed flex items-start gap-2.5">
  <span class="text-sm">⚖️</span>
  <div>
    <strong class="font-bold text-[#1C1625] block mb-0.5">{t('disclaimer.title', locale)}</strong>
    <p>{disclaimerText}</p>
  </div>
</div>

