---
import { localesConfig, supportedLocales } from '../../config/locales.config';
import { t } from '../../i18n';

interface Props {
  currentLocale: string;
}

const { currentLocale } = Astro.props;
const currentConfig = localesConfig[currentLocale] || localesConfig['en'];

// Strip current locale prefix from current pathname to build target locale links
const rawPath = Astro.url.pathname.replace(/^\/[a-z]{2}/, '').replace(/^\/+|\/+$/g, '');
const targetPath = rawPath ? `/${rawPath}/` : '/';
---

<div class="relative inline-block text-left" id="languageSwitcherContainer">
  <!-- Trigger Button -->
  <button
    id="langDropdownTrigger"
    type="button"
    aria-expanded="false"
    aria-haspopup="true"
    aria-label="Select language"
    class="flex items-center gap-2 px-3 py-1.5 rounded bg-[#311E43] hover:bg-[#3d2653] border border-[#C4A052]/50 text-white text-xs font-mono font-semibold transition-all cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#C4A052]"
  >
    <span class="text-sm text-[#C4A052]">🌐</span>
    <span class="font-medium text-amber-100">{currentConfig.nativeName}</span>
    <span class="text-[10px] text-[#C4A052] uppercase font-mono tracking-wider">({currentLocale})</span>
    <span class="text-stone-300 text-[9px]">▼</span>
  </button>

  <!-- Dropdown Modal Panel -->
  <div
    id="langDropdownPanel"
    class="hidden absolute right-0 sm:right-auto sm:left-1/2 sm:-translate-x-1/2 mt-2 w-72 sm:w-80 rounded-md bg-[#FBF9F5] shadow-2xl border-2 border-[#C4A052] z-50 overflow-hidden text-[#1C1625]"
  >
    <!-- Search Bar -->
    <div class="p-3 bg-[#231530] text-white border-b border-[#C4A052]/40">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-bold text-amber-200 flex items-center gap-1.5 font-serif">
          <span class="text-[#C4A052]">🌐</span> {t('lang.selectLanguage', currentLocale)}
        </span>
        <span class="text-[10px] text-[#C4A052] bg-white/10 px-2 py-0.5 rounded font-mono">40 Locales</span>
      </div>
      <input
        type="text"
        id="langSearchInput"
        placeholder={t('lang.searchPlaceholder', currentLocale)}
        class="w-full px-3 py-1.5 rounded bg-[#FFFFFF] border border-[#D8D0C5] text-xs text-[#1C1625] placeholder-[#524B5A] focus:outline-none focus:border-[#C4A052]"
      />
    </div>

    <!-- Language Grid / List -->
    <div class="max-h-72 overflow-y-auto p-2 space-y-1" id="langListContainer">
      {supportedLocales.map((code) => {
        const item = localesConfig[code];
        const isSelected = code === currentLocale;
        const href = `/${code}${targetPath}`;
        return (
          <a
            href={href}
            data-lang-code={code}
            data-lang-name={item.name.toLowerCase()}
            data-lang-native={item.nativeName.toLowerCase()}
            class={`lang-item-btn flex items-center justify-between px-3 py-2 rounded text-xs transition-colors ${
              isSelected
                ? 'bg-[#231530] text-amber-200 font-bold border border-[#C4A052]'
                : 'text-[#1C1625] hover:bg-[#F5F2EB] hover:text-[#9E7B3B]'
            }`}
          >
            <div class="flex items-center gap-2">
              <span class="font-bold">{item.nativeName}</span>
              <span class="text-[11px] text-[#524B5A]">({item.name})</span>
            </div>
            <div class="flex items-center gap-1">
              <span class="text-[10px] uppercase font-mono px-1.5 py-0.5 rounded bg-stone-200 text-stone-700 font-bold">
                {code}
              </span>
              {isSelected && <span class="text-xs text-[#C4A052]">✓</span>}
            </div>
          </a>
        );
      })}
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const container = document.getElementById('languageSwitcherContainer');
    const trigger = document.getElementById('langDropdownTrigger');
    const panel = document.getElementById('langDropdownPanel');
    const searchInput = document.getElementById('langSearchInput');
    const langItems = document.querySelectorAll('.lang-item-btn');

    if (!container || !trigger || !panel) return;

    let isOpen = false;

    function openDropdown() {
      isOpen = true;
      trigger.setAttribute('aria-expanded', 'true');
      panel.classList.remove('hidden');
      if (searchInput) {
        setTimeout(() => searchInput.focus(), 50);
      }
    }

    function closeDropdown() {
      isOpen = false;
      trigger.setAttribute('aria-expanded', 'false');
      panel.classList.add('hidden');
    }

    trigger.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      if (isOpen) {
        closeDropdown();
      } else {
        openDropdown();
      }
    });

    container.addEventListener('click', (e) => {
      e.stopPropagation();
    });

    document.addEventListener('click', () => {
      if (isOpen) {
        closeDropdown();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closeDropdown();
        trigger.focus();
      }
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        langItems.forEach((item) => {
          const code = item.getAttribute('data-lang-code') || '';
          const name = item.getAttribute('data-lang-name') || '';
          const native = item.getAttribute('data-lang-native') || '';
          if (code.includes(query) || name.includes(query) || native.includes(query)) {
            item.style.display = 'flex';
          } else {
            item.style.display = 'none';
          }
        });
      });
    }
  })();
</script>
