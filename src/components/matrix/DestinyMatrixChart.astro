---
interface Props {
  dayArcana?: number;
  monthArcana?: number;
  yearArcana?: number;
  bottomArcana?: number;
  centerArcana?: number;
  topLeftArcana?: number;
  topRightArcana?: number;
  bottomRightArcana?: number;
  bottomLeftArcana?: number;
  moneyArcana?: number;
  loveArcana?: number;
}

const {
  dayArcana = 14,
  monthArcana = 1,
  yearArcana = 6,
  bottomArcana = 21,
  centerArcana = 6,
  topLeftArcana = 15,
  topRightArcana = 7,
  bottomRightArcana = 9,
  bottomLeftArcana = 8,
  moneyArcana = 18,
  loveArcana = 21,
} = Astro.props;

// Math Helper: Position numbers OUTSIDE the hexagon line boundary (positive offsetDistance = push outside hex line)
function getEdgeRotatedNumbers(p1: [number, number], p2: [number, number], numbers: number[], offsetDistance: number = 22) {
  const dx = p2[0] - p1[0];
  const dy = p2[1] - p1[1];
  const lineLen = Math.hypot(dx, dy);
  
  // Normal vector pointing OUTWARD away from center (270, 270)
  let nx = -dy / lineLen;
  let ny = dx / lineLen;

  // Midpoint of line segment
  const mx = (p1[0] + p2[0]) / 2;
  const my = (p1[1] + p2[1]) / 2;
  
  // Vector from center (270, 270) to midpoint
  const vcx = mx - 270;
  const vcy = my - 270;

  // Ensure normal vector points outward (dot product > 0)
  if (nx * vcx + ny * vcy < 0) {
    nx = -nx;
    ny = -ny;
  }
  
  // Angle of line in degrees
  let angle = Math.atan2(dy, dx) * (180 / Math.PI);
  if (angle > 90) angle -= 180;
  if (angle < -90) angle += 180;

  const count = numbers.length;
  return numbers.map((num, i) => {
    // Distribute evenly along the edge segment between 12% and 88%
    const t = 0.14 + (i / (count - 1)) * 0.72;
    const lx = p1[0] + t * dx;
    const ly = p1[1] + t * dy;
    
    // Push OUTSIDE the green hexagon line by offsetDistance
    const x = lx + nx * offsetDistance;
    const y = ly + ny * offsetDistance;
    
    return { num, x, y, angle };
  });
}

// 6 Outer Hexagon Edges
const hexVerts: [number, number][] = [
  [90, 158],  // 0: Top-Left (10y)
  [270, 55],  // 1: Top (20y)
  [450, 158], // 2: Top-Right (30y)
  [450, 382], // 3: Bottom-Right (50y)
  [270, 485], // 4: Bottom (60y)
  [90, 382]   // 5: Bottom-Left (70y)
];

// offsetDistance: 24px for top/bottom edges, 35px for right/left edges to push past node circles (radius 24)
const edge1 = getEdgeRotatedNumbers(hexVerts[0], hexVerts[1], [19, 4, 20, 16, 6, 17, 18], 24);
const edge2 = getEdgeRotatedNumbers(hexVerts[1], hexVerts[2], [10, 9, 17, 8, 5, 15, 22], 24);
const edge3 = getEdgeRotatedNumbers(hexVerts[2], hexVerts[3], [9, 20, 6, 13, 5, 19, 7], 35);
const edge4 = getEdgeRotatedNumbers(hexVerts[3], hexVerts[4], [15, 6, 21, 15, 9, 21, 9], 24);
const edge5 = getEdgeRotatedNumbers(hexVerts[4], hexVerts[5], [9, 6, 9, 3, 15, 12, 21], 24);
const edge6 = getEdgeRotatedNumbers(hexVerts[5], hexVerts[0], [5, 9, 4, 22, 7, 3, 11], 35);
