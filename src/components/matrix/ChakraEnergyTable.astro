---
import { t } from '../../i18n';

interface Props {
  locale?: string;
  chakras?: Array<{
    name: string;
    key?: string;
    sanskrit?: string;
    physics: number;
    energy: number;
    emotions: number;
  }>;
}

const { locale = 'en', chakras = [
  { name: 'Crown (Sahasrara)', key: 'chakra.crown', physics: 14, energy: 1, emotions: 15 },
  { name: 'Third eye (Ajna)', key: 'chakra.thirdEye', physics: 7, energy: 8, emotions: 15 },
  { name: 'Throat (Vishuddha)', key: 'chakra.throat', physics: 20, energy: 7, emotions: 9 },
  { name: 'Heart (Anahata)', key: 'chakra.heart', physics: 8, energy: 13, emotions: 21 },
  { name: 'Solar plexus (Manipura)', key: 'chakra.solarPlexus', physics: 6, energy: 6, emotions: 12 },
  { name: 'Sacral (Swadhisthana)', key: 'chakra.sacral', physics: 9, energy: 12, emotions: 21 },
  { name: 'Root (Muladhara)', key: 'chakra.root', physics: 6, energy: 21, emotions: 9 },
] } = Astro.props;

const chakraTextColors: Record<string, string> = {
  'Crown (Sahasrara)': 'text-[#9B51E0]',
  'Third eye (Ajna)': 'text-[#4A6FA5]',
  'Throat (Vishuddha)': 'text-[#2F80ED]',
  'Heart (Anahata)': 'text-[#27AE60]',
  'Solar plexus (Manipura)': 'text-[#E2A03F]',
  'Sacral (Swadhisthana)': 'text-[#E67E22]',
  'Root (Muladhara)': 'text-[#EB5757]'
};
---

<div class="bg-white rounded-3xl p-6 sm:p-8 border border-stone-200/80 shadow-md space-y-4">
  <!-- Table Header -->
  <div class="flex justify-between items-center pb-2">
    <span class="text-xs font-serif text-[#B67B7B]">{t('chakra.tableName', locale)}</span>
    <div class="flex items-center gap-12 sm:gap-16 pr-4 text-xs font-serif text-[#B67B7B]">
      <span>{t('chakra.physics', locale)}</span>
      <span>{t('chakra.energy', locale)}</span>
      <span>{t('chakra.emotions', locale)}</span>
    </div>
  </div>

  <!-- Rounded Rows matching user screenshot -->
  <div class="space-y-3">
    {chakras.map((c) => {
      const translatedName = c.key ? t(c.key, locale) : c.name;
      const displayName = c.sanskrit ? `${translatedName} (${c.sanskrit})` : translatedName;
      const textColor = chakraTextColors[c.name] || 'text-stone-700';
      return (
        <div class="bg-[#FDFBF7] hover:bg-[#F7F3EC] transition-colors rounded-2xl p-4 flex items-center justify-between border border-stone-100 shadow-2xs">
          <span class={`font-bold text-sm ${textColor}`}>{displayName}</span>
          <div class="flex items-center gap-14 sm:gap-20 text-stone-700 font-semibold text-sm pr-2">
            <span class="w-6 text-center">{c.physics}</span>
            <span class="w-6 text-center">{c.energy}</span>
            <span class="w-6 text-center">{c.emotions}</span>
          </div>
        </div>
      );
    })}

    <!-- Bottom Result Summary Row (Matching Screenshot) -->
    <div class="bg-[#C99494] text-white rounded-2xl p-4 flex items-center justify-between shadow-xs font-bold text-sm">
      <span>{t('chakra.result', locale)}</span>
      <div class="flex items-center gap-14 sm:gap-20 pr-2">
        <span class="w-6 text-center">7</span>
        <span class="w-6 text-center">14</span>
        <span class="w-6 text-center">12</span>
      </div>
    </div>
  </div>
</div>

