---
import LanguageSwitcher from '../common/LanguageSwitcher.astro';
import { t } from '../../i18n';
import { headerNavTaxonomy } from '../../config/navigation.config';

interface Props {
  locale?: string;
  currentPath?: string;
}

const { locale = 'en', currentPath = '' } = Astro.props;

function isLinkActive(href: string): boolean {
  const fullHref = `/${locale}/${href}`;
  if (href === '' && (currentPath === `/${locale}/` || currentPath === `/${locale}`)) {
    return true;
  }
  return href !== '' && currentPath.includes(`/${href}`);
}
---

<header class="border-b-2 border-[#C4A052] bg-[#231530] text-white sticky top-0 z-50 shadow-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="h-16 flex items-center justify-between">
      
      <!-- Brand Logo -->
      <a href={`/${locale}/`} class="flex items-center gap-2 font-serif tracking-widest text-amber-100 uppercase text-lg font-bold hover:text-amber-200 transition-colors">
        <span class="text-xl text-[#C4A052]">✨</span>
        <span>Souliography</span>
      </a>

      <!-- Desktop Reference Navigation Bar -->
      <nav class="hidden lg:flex items-center space-x-1 text-xs font-mono font-semibold" aria-label="Main Navigation">
        {headerNavTaxonomy.map((item) => {
          const label = t(item.key, locale);
          const active = isLinkActive(item.href);
          const hasChildren = item.children && item.children.length > 0;

          if (!hasChildren) {
            return (
              <a
                href={`/${locale}/${item.href}`}
                class={`px-3 py-2 rounded transition-colors ${active ? 'bg-[#311E43] text-[#C4A052] font-bold border border-[#C4A052]/40' : 'text-stone-200 hover:text-white hover:bg-white/10'}`}
              >
                {label}
              </a>
            );
          }

          return (
            <div class="relative group">
              <a
                href={`/${locale}/${item.href}`}
                class={`px-3 py-2 rounded flex items-center gap-1 transition-colors ${active ? 'bg-[#311E43] text-[#C4A052] font-bold border border-[#C4A052]/40' : 'text-stone-200 hover:text-white hover:bg-white/10'}`}
              >
                <span>{label}</span>
                <span class="text-[9px] text-[#C4A052]">▼</span>
              </a>
              
              <div class="absolute left-0 top-full hidden group-hover:block w-60 pt-1 z-50">
                <div class="bg-[#FBF9F5] text-[#1C1625] rounded border border-[#D8D0C5] shadow-xl p-2 space-y-1">
                  {item.children?.map((child, idx) => (
                    <>
                      {idx === 1 && <div class="border-t border-[#D8D0C5] my-1" />}
                      <a
                        href={`/${locale}/${child.href}`}
                        class={`block px-3 py-1.5 rounded ${idx === 0 ? 'text-xs font-bold text-[#231530] hover:bg-[#F5F2EB] hover:text-[#9E7B3B]' : 'text-[11px] text-[#524B5A] hover:bg-[#F5F2EB] hover:text-[#1C1625]'}`}
                      >
                        {t(child.key, locale)}
                      </a>
                    </>
                  ))}
                </div>
              </div>
            </div>
          );
        })}
      </nav>

      <!-- Language Switcher -->
      <div class="flex items-center gap-2">
        <LanguageSwitcher currentLocale={locale} />
      </div>

    </div>
  </div>
</header>
