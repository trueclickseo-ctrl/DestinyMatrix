---
import LanguageSwitcher from '../common/LanguageSwitcher.astro';
import { t } from '../../i18n';
import { headerNavTaxonomy } from '../../config/navigation.config';

interface Props {
  locale?: string;
  currentPath?: string;
}

const { locale = 'en', currentPath = '' } = Astro.props;

function isLinkActive(href: string): boolean {
  const fullHref = `/${locale}/${href}`;
  if (href === '' && (currentPath === `/${locale}/` || currentPath === `/${locale}`)) {
    return true;
  }
  return href !== '' && currentPath.includes(`/${href}`);
}
---

<header class="border-b-2 border-[#C4A052] bg-[#231530] text-white sticky top-0 z-50 shadow-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="h-16 flex items-center justify-between">
      
      <!-- Brand Logo -->
      <a href={`/${locale}/`} class="flex items-center gap-2.5 group py-1">
        <img
          src="/logo-horizontal.svg"
          alt="Souliography — Soul Matrix & Numerology"
          class="h-9 w-auto max-w-[200px] sm:max-w-[240px] object-contain"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
        />
        <div class="hidden items-center gap-2 font-serif tracking-widest text-amber-100 uppercase text-lg font-bold group-hover:text-amber-200 transition-colors">
          <span class="text-xl text-[#C4A052]">✨</span>
          <span>Souliography</span>
        </div>
      </a>

      <!-- Desktop Navigation Bar -->
      <nav class="hidden lg:flex items-center gap-1 text-sm font-sans font-bold" aria-label="Main Navigation">
        {headerNavTaxonomy.map((item) => {
          const label = t(item.key, locale);
          const active = isLinkActive(item.href);
          const hasChildren = item.children && item.children.length > 0;

          if (!hasChildren) {
            return (
              <a
                href={`/${locale}/${item.href}`}
                class={`px-3.5 py-2 rounded-md transition-colors ${active ? 'bg-[#311E43] text-[#C4A052] font-bold border border-[#C4A052]/50' : 'text-stone-100 hover:text-white hover:bg-white/10'}`}
              >
                {label}
              </a>
            );
          }

          return (
            <div class="relative group">
              <a
                href={`/${locale}/${item.href}`}
                class={`px-3.5 py-2 rounded-md flex items-center gap-1.5 transition-colors ${active ? 'bg-[#311E43] text-[#C4A052] font-bold border border-[#C4A052]/50' : 'text-stone-100 hover:text-white hover:bg-white/10'}`}
              >
                <span>{label}</span>
                <span class="text-[10px] text-[#C4A052]">▼</span>
              </a>
              
              <div class="absolute start-0 top-full hidden group-hover:block w-64 pt-1.5 z-50">
                <div class="bg-[#FBF9F5] text-[#1C1625] rounded-md border border-[#D8D0C5] shadow-2xl p-2.5 space-y-1 text-start">
                  {item.children?.map((child, idx) => (
                    <>
                      {idx === 1 && <div class="border-t border-[#D8D0C5] my-1" />}
                      <a
                        href={`/${locale}/${child.href}`}
                        class={`block px-3 py-2 rounded-md ${idx === 0 ? 'text-sm font-bold text-[#231530] hover:bg-[#F5F2EB] hover:text-[#9E7B3B]' : 'text-xs font-semibold text-[#524B5A] hover:bg-[#F5F2EB] hover:text-[#1C1625]'}`}
                      >
                        {t(child.key, locale)}
                      </a>
                    </>
                  ))}
                </div>
              </div>
            </div>
          );
        })}
      </nav>

      <!-- Right Action Items: Language Switcher & Mobile Menu Toggle -->
      <div class="flex items-center gap-3">
        <LanguageSwitcher currentLocale={locale} />

        <!-- Mobile Menu Toggle Button (Bug 3 responsive nav) -->
        <button
          id="mobileMenuToggleBtn"
          type="button"
          aria-expanded="false"
          aria-controls="mobileNavDrawer"
          aria-label="Toggle navigation menu"
          class="lg:hidden p-2 rounded-md text-amber-200 hover:text-white hover:bg-white/10 border border-[#C4A052]/40 transition-colors"
        >
          <svg id="hamburgerIcon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg id="closeIcon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobileNavDrawer" class="hidden lg:hidden bg-[#1C0D26] border-b-2 border-[#C4A052] px-4 pt-3 pb-6 space-y-3 font-sans text-start">
    {headerNavTaxonomy.map((item) => {
      const label = t(item.key, locale);
      const active = isLinkActive(item.href);
      const hasChildren = item.children && item.children.length > 0;

      if (!hasChildren) {
        return (
          <a
            href={`/${locale}/${item.href}`}
            class={`block px-4 py-2.5 rounded-lg text-sm font-bold transition-colors ${active ? 'bg-[#311E43] text-[#C4A052] border border-[#C4A052]/40' : 'text-stone-100 hover:bg-white/10'}`}
          >
            {label}
          </a>
        );
      }

      return (
        <div class="space-y-1">
          <div class="px-4 py-2 text-xs font-mono font-bold uppercase tracking-wider text-amber-300 border-b border-[#C4A052]/30">
            {label}
          </div>
          <div class="ps-3 space-y-1">
            {item.children?.map((child) => (
              <a
                href={`/${locale}/${child.href}`}
                class="block px-4 py-2 rounded-md text-xs font-semibold text-stone-200 hover:text-amber-200 hover:bg-white/5 transition-colors"
              >
                › {t(child.key, locale)}
              </a>
            ))}
          </div>
        </div>
      );
    })}
  </div>
</header>

<script is:inline>
  (() => {
    const toggleBtn = document.getElementById('mobileMenuToggleBtn');
    const drawer = document.getElementById('mobileNavDrawer');
    const hamburgerIcon = document.getElementById('hamburgerIcon');
    const closeIcon = document.getElementById('closeIcon');

    if (!toggleBtn || !drawer) return;

    let isOpen = false;

    toggleBtn.addEventListener('click', () => {
      isOpen = !isOpen;
      toggleBtn.setAttribute('aria-expanded', String(isOpen));
      if (isOpen) {
        drawer.classList.remove('hidden');
        hamburgerIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
      } else {
        drawer.classList.add('hidden');
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      }
    });
  })();
</script>

