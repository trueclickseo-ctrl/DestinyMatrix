---
import { t } from '../../i18n';
import LanguageSwitcher from '../common/LanguageSwitcher.astro';
import { footerNavTaxonomy } from '../../config/navigation.config';

interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
---

<footer class="bg-[#231530] text-white border-t-2 border-[#C4A052] py-12 px-4 font-sans text-xs" style="background-color: #231530; color: #ffffff;">
  <div class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-8">
    
    {footerNavTaxonomy.map((col) => (
      <div class="space-y-3 text-start">
        <h4 class="font-serif text-sm font-semibold text-[#F3E8C8] uppercase tracking-wider border-b border-[#C4A052]/40 pb-1.5" style="color: #F3E8C8 !important;">
          {t(col.titleKey, locale)}
        </h4>
        <ul class="space-y-2 text-[#EAE5F5]">
          {col.items.map((item) => (
            <li>
              <a
                href={`/${locale}/${item.href}`}
                class="text-[#EAE5F5] hover:text-[#FDE68A] hover:underline transition-colors block py-0.5"
                style="color: #EAE5F5 !important;"
              >
                {t(item.key, locale)}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <!-- Brand & Language Switcher Column -->
    <div class="space-y-3 text-start sm:col-span-2 lg:col-span-1">
      <div class="flex items-center gap-2 font-serif text-[#F3E8C8] uppercase tracking-widest text-sm font-bold" style="color: #F3E8C8 !important;">
        <span class="text-amber-400">✨</span>
        <span>Souliography</span>
      </div>
      <p class="text-[#D1C7DF] leading-relaxed text-[11px]" style="color: #D1C7DF !important;">
        {t('footer.about', locale)}
      </p>
      <div class="pt-2">
        <LanguageSwitcher currentLocale={locale} />
      </div>
    </div>

  </div>

  <div class="max-w-7xl mx-auto border-t border-[#C4A052]/30 mt-10 pt-4 flex flex-wrap items-center justify-between text-[11px] text-[#C5BCCF]" style="color: #C5BCCF !important;">
    <p style="color: #C5BCCF !important;">© {new Date().getFullYear()} Souliography. {t('footer.copyright', locale)}</p>
    <p class="italic" style="color: #C5BCCF !important;">Digital Occult Reference Library Architecture</p>
  </div>
</footer>
