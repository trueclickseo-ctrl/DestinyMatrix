---
import { t } from '../../i18n';
import LanguageSwitcher from '../common/LanguageSwitcher.astro';
import { footerNavTaxonomy } from '../../config/navigation.config';

interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
---

<footer class="bg-[#231530] text-white border-t-2 border-[#C4A052] py-12 px-4 font-sans text-xs">
  <div class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8">
    
    {footerNavTaxonomy.map((col) => (
      <div class="space-y-3 text-start">
        <h4 class="font-serif text-sm font-medium text-[#e8c77c] uppercase tracking-widest border-b border-[#4a3a5c] pb-1">
          {t(col.titleKey, locale)}
        </h4>
        <ul class="space-y-2 text-stone-300">
          {col.items.map((item) => (
            <li>
              <a
                href={`/${locale}/${item.href}`}
                class="text-[#e8e2f2] hover:text-[#fde68a] hover:underline transition-colors block"
              >
                {t(item.key, locale)}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <!-- Brand & Language Switcher Column -->
    <div class="space-y-3 sm:col-span-2 md:col-span-1">
      <div class="flex items-center gap-2 font-serif text-amber-100 uppercase tracking-widest text-sm font-bold">
        <span class="text-amber-400">✨</span>
        <span>Souliography</span>
      </div>
      <p class="text-stone-300 leading-relaxed text-[11px]">
        {t('footer.about', locale)}
      </p>
      <div class="pt-2">
        <LanguageSwitcher currentLocale={locale} />
      </div>
    </div>

  </div>

  <div class="max-w-7xl mx-auto border-t border-[#C4A052]/30 mt-8 pt-4 flex flex-wrap items-center justify-between text-[11px] text-stone-400">
    <p>© {new Date().getFullYear()} Souliography. {t('footer.copyright', locale)}</p>
    <p class="italic">Digital Occult Reference Library Architecture</p>
  </div>
</footer>
