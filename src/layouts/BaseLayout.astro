---
import { brandConfig } from '../config/brand.config';
import { localesConfig } from '../config/locales.config';
import { SEOEngine } from '../engines/seo';
import { SchemaEngine } from '../engines/schema';
import SiteNavigation from '../components/navigation/SiteNavigation.astro';
import FooterNavigation from '../components/navigation/FooterNavigation.astro';
import '../design-system/global.css';

interface Props {
  title: string;
  description: string;
  ogDescription?: string;
  locale?: string;
  noIndex?: boolean;
}

const { title, description, ogDescription, locale = 'en', noIndex = false } = Astro.props;
const currentLocaleConfig = localesConfig[locale] || localesConfig['en'];
const rawPath = Astro.url.pathname.replace(/^\/[a-z]{2}/, '').replace(/^\/+|\/+$/g, '');
const canonicalUrl = rawPath ? `https://${brandConfig.domain}/${locale}/${rawPath}/` : `https://${brandConfig.domain}/${locale}/`;

const seoMeta = SEOEngine.generateMeta({
  title,
  description,
  canonicalUrl,
  locale,
  availableLocales: Object.keys(localesConfig),
});

const ogDesc = ogDescription ?? description;
const websiteSchema = SchemaEngine.generateWebSiteSchema(`https://${brandConfig.domain}`);
---

<!DOCTYPE html>
<html lang={locale} dir={currentLocaleConfig.dir} class="h-full scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon.svg" />
    <meta name="theme-color" content="#231530" />

    <!-- Manifest -->
    <link rel="manifest" href="/manifest.json" />

    <!-- Title & Description -->
    <title>{seoMeta.title}</title>
    <meta name="description" content={seoMeta.description} />

    <!-- Robots -->
    <meta name="robots" content={noIndex ? "noindex, nofollow" : "index, follow"} />

    <!-- Canonical & Hreflang -->
    <link rel="canonical" href={seoMeta.canonical} />
    {seoMeta.hreflangs.map((h) => (
      <link rel="alternate" hreflang={h.lang} href={h.href} />
    ))}

    <!-- OpenGraph -->
    <meta property="og:title" content={seoMeta.openGraph.title} />
    <meta property="og:description" content={ogDesc} />
    <meta property="og:url" content={seoMeta.openGraph.url} />
    <meta property="og:image" content={seoMeta.openGraph.image} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Souliography" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoMeta.title} />
    <meta name="twitter:description" content={ogDesc} />
    <meta name="twitter:image" content={seoMeta.openGraph.image} />
    <meta name="twitter:site" content="@souliography" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Cinzel:wght@500;700;800&family=EB+Garamond:ital,wght@0,400;0,600;1,400&family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,700;1,400&display=swap" rel="stylesheet" />

    <!-- Schema JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </head>
  <body class="min-h-full flex flex-col bg-[#FBF9F5] text-[#1C1625] antialiased">
    <!-- Global Persistent Header Navigation -->
    <SiteNavigation locale={locale} currentPath={Astro.url.pathname} />

    <!-- Main Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Global Persistent Footer Navigation -->
    <FooterNavigation locale={locale} />
  </body>
</html>
